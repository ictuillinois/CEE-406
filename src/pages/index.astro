---
import BaseLayout from '../layouts/BaseLayout.astro';
import PavementHero from '../components/PavementHero.astro';
import LayerGlyph from '../components/LayerGlyph.astro';
import Icon from '../components/Icon.astro';
import { homeworks } from '../data/homeworks';
import { chapters, appendices } from '../data/textbook';
import { tools, toolHref } from '../data/tools';

const base = import.meta.env.BASE_URL;


---

<BaseLayout
  title="CEE 406 · Pavement Design I"
  description="Course portal for CEE 406 Pavement Design I at UIUC — homework assignments, online design tools, and the Huang (2004) textbook."
>
  <PavementHero />

  <!-- ── Homework timeline ── -->
  <section class="section" id="homeworks">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <span class="section-eyebrow">The semester, homework by homework</span>
        <h2>Ten assignments, one structure</h2>
        <p>
          The course is organized around its homeworks. Each one pairs the assignment with
          the textbook chapters behind it and the tools you need to solve it — from surface
          distresses down to the subgrade, and back up through design.
        </p>
      </div>

      <ol class="hw-grid stagger-grid" role="list">
        {homeworks.map(hw => (
          <li class="gsap-stagger">
            <a href={`${base}homeworks/${hw.id}/`} class="hw-card" data-phase={hw.phase}>
              <div class="hw-card__top">
                <LayerGlyph focus={hw.layerFocus} />
                <span class="hw-card__num">HW{hw.num}</span>
                <span class="hw-card__due"><Icon name="calendar" size={13} />{hw.due}</span>
              </div>
              <h3 class="hw-card__title">{hw.title}</h3>
              <p class="hw-card__desc">{hw.overview}</p>
              <div class="hw-card__foot">
                <span class="hw-card__phase">{hw.phase}</span>
                {hw.tools.some(t => t.href) && (
                  <span class="hw-card__tool"><Icon name="sliders" size={12} />tool</span>
                )}
                <Icon name="arrow-right" size={15} class="hw-card__go" />
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Tools ── -->
  <section class="section section--alt" id="tools">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <span class="section-eyebrow">Online tools</span>
        <h2>Solve it in the browser</h2>
        <p>
          {tools.length} interactive tools built for the homeworks — no installation, no
          license, nothing to hand in but the thinking. Where a tool implements the book's
          physics it is checked against the worked answers printed in Huang, so you can
          calibrate it before you trust it.
        </p>
      </div>

      <div class="tools-grid stagger-grid">
        {tools.map(t => (
          <a href={toolHref(base, t)} class="tool-mini gsap-stagger" style={`--tool-color: ${t.color}`}>
            <span class="tool-mini__glyph" aria-hidden="true">
              <Fragment set:html={t.glyph} />
            </span>
            <span class="tool-mini__name">{t.name}</span>
            <span class="tool-mini__hws">{t.hws.join(' · ')}</span>
          </a>
        ))}
      </div>

      <a href={`${base}tools/`} class="tools-all gsap-fade-up">
        Every tool, with what it implements and why &rarr;
      </a>
    </div>
  </section>

  <!-- ── Textbook ── -->
  <section class="section" id="textbook">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <span class="section-eyebrow">Course textbook</span>
        <h2>Huang — <em>Pavement Analysis and Design</em></h2>
        <p>
          The full second edition (2004), readable online chapter by chapter:
          {chapters.length} chapters and {appendices.length} appendices, each linked from the
          homework that uses it.
        </p>
      </div>

      <div class="tb-strip gsap-fade-up" role="list">
        {chapters.map(ch => (
          <a href={`${base}textbook/${ch.id}/`} class="tb-chip" role="listitem" title={ch.desc}>
            <span class="tb-chip__num">{ch.num}</span>
            <span class="tb-chip__title">{ch.title}</span>
          </a>
        ))}
      </div>

      <div class="tb-sublabel gsap-fade-up"><Icon name="book" size={13} />Appendices</div>
      <div class="tb-strip tb-strip--appendix gsap-fade-up" role="list">
        {appendices.map(ap => (
          <a href={`${base}textbook/${ap.id}/`} class="tb-chip tb-chip--appendix" role="listitem" title={ap.desc}>
            <span class="tb-chip__num">{ap.num}</span>
            <span class="tb-chip__title">{ap.title}</span>
          </a>
        ))}
      </div>

      <div class="tb-actions gsap-fade-up">
        <a href={`${base}textbook/`} class="btn btn-primary">
          Open the textbook<Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    margin-bottom: 0.625rem;
  }

  .section-head h2 {
    margin: 0 0 0.75rem;
  }

  .section-head h2 em {
    font-style: italic;
    font-weight: 600;
  }

  .section-head p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .section--alt {
    background: var(--color-surface-alt);
  }

  :global([data-theme="dark"]) .section--alt {
    background: #0D1526;
  }

  /* ── Homework grid ── */
  .hw-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 0.875rem;
  }

  .hw-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.125rem 1.25rem 1rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* The phase rule. Always present at low opacity so the grid reads as five
     coloured groups at a glance; full strength on hover. */
  .hw-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--phase, var(--color-accent));
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .hw-card:hover {
    border-color: var(--phase, var(--color-accent));
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(15, 26, 46, 0.10);
  }

  .hw-card:hover::before { opacity: 1; }

  :global([data-theme="dark"]) .hw-card {
    background: #162033;
    border-color: #2D3F59;
  }

  :global([data-theme="dark"]) .hw-card:hover {
    border-color: var(--phase, var(--color-accent));
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.34);
  }

  .hw-card__top {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .hw-card__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--phase, var(--color-accent));
  }

  .hw-card__due {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .hw-card__title {
    font-size: 1rem;
    margin: 0 0 0.4rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  /* Clamped rather than cut in JS: `overview.slice(0, 110)` chopped words in
     half mid-syllable. The browser knows where the line ends; we do not. */
  .hw-card__desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 0.875rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hw-card__foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hw-card__phase {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    color: var(--phase, var(--color-accent));
    background: color-mix(in srgb, var(--phase, var(--color-accent)) 12%, transparent);
  }

  .hw-card__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-text-muted) 12%, transparent);
  }

  /* The affordance slides out on hover — the card is a link, and this is the
     only thing on it that says so. */
  /* :global — the arrow is rendered by <Icon>, so it carries no scope hash
     from this file and a bare class selector would never match it. */
  :global(.hw-card__go) {
    margin-left: auto;
    color: var(--phase, var(--color-accent));
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hw-card:hover :global(.hw-card__go),
  .hw-card:focus-visible :global(.hw-card__go) {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tb-chip { transition: none; }
    .tb-chip:hover { transform: none; box-shadow: none; }
    .hw-card { transition: none; }
    .hw-card:hover { transform: none; }
    :global(.hw-card__go) { opacity: 1; transform: none; transition: none; }
  }

  /* ── Tool miniatures ────────────────────────────────────────────────
     Small, glyph-forward cards: the landing page shows WHAT each tool does
     at a glance and leaves the prose to /tools/. The motif is the same SVG
     the tools page uses, so the two surfaces read as one system. */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
    gap: 0.625rem;
  }

  .tool-mini {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.75rem 0.875rem 0.8rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* The accent bar is always visible here, at low opacity — it is the only
     colour a miniature carries, so it doubles as the category marker. */
  .tool-mini::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--tool-color, var(--color-accent));
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .tool-mini:hover {
    border-color: var(--tool-color, var(--color-accent));
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 26, 46, 0.09);
  }

  .tool-mini:hover::before { opacity: 1; }

  :global([data-theme="dark"]) .tool-mini {
    background: #162033;
    border-color: #2D3F59;
  }

  :global([data-theme="dark"]) .tool-mini:hover {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  }

  .tool-mini__glyph {
    display: block;
    color: var(--tool-color, var(--color-accent));
    background: color-mix(in srgb, var(--tool-color, var(--color-accent)) 8%, transparent);
    border-radius: 7px;
    padding: 0.3rem 0.5rem;
    margin-bottom: 0.55rem;
  }

  .tool-mini__glyph :global(svg) {
    display: block;
    width: 100%;
    height: 38px;
    transition: transform 0.25s ease;
  }

  .tool-mini:hover .tool-mini__glyph :global(svg) {
    transform: translateY(-1px) scale(1.03);
  }

  @keyframes tool-mini-draw {
    from { stroke-dasharray: 320; stroke-dashoffset: 320; }
    to { stroke-dasharray: 320; stroke-dashoffset: 0; }
  }

  .tool-mini:hover .tool-mini__glyph :global(path.anim),
  .tool-mini:hover .tool-mini__glyph :global(rect.anim) {
    animation: tool-mini-draw 0.9s ease;
  }

  .tool-mini__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.3;
    text-wrap: balance;
    /* Two lines reserved so every miniature is the same height and the grid
       reads as a set rather than a ragged pile. */
    min-height: 2.6em;
  }

  .tool-mini__hws {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .tools-all {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .tools-all:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .tool-mini,
    .tool-mini__glyph :global(svg),
    .tool-mini:hover .tool-mini__glyph :global(path.anim),
    .tool-mini:hover .tool-mini__glyph :global(rect.anim) {
      transition: none;
      animation: none;
    }
    .tool-mini:hover { transform: none; }
  }

  /* ── Textbook strip ── */
  .tb-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tb-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem 0.45rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    background: #fff;
    transition: border-color 0.15s ease, background 0.15s ease,
                transform 0.15s ease, box-shadow 0.15s ease;
    max-width: 100%;
  }

  .tb-chip:hover {
    border-color: var(--color-accent);
    background: rgba(232, 119, 34, 0.05);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(15, 26, 46, 0.07);
  }

  .tb-chip:hover .tb-chip__num {
    background: var(--color-accent);
    color: #fff;
  }

  /* Appendices are the same object at lower emphasis — neutral until hovered,
     so the eye reads thirteen chapters first and seven appendices second. */
  .tb-strip--appendix { margin-bottom: 1.5rem; }

  .tb-chip--appendix .tb-chip__num {
    background: color-mix(in srgb, var(--color-text-muted) 14%, transparent);
    color: var(--color-text-muted);
  }

  .tb-sublabel {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.25rem 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .tb-chip {
    background: #162033;
    border-color: #2D3F59;
  }

  .tb-chip__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    background: rgba(232, 119, 34, 0.1);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    flex-shrink: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tb-chip__title {
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 16rem;
  }

  .tb-actions {
    display: flex;
    gap: 0.75rem;
  }
</style>
