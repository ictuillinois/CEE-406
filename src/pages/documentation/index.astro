---
import SoftwareDocsLayout from '../../layouts/SoftwareDocsLayout.astro';
const base = import.meta.env.BASE_URL;
const software = [
  { id: 'faarfield', name: 'FAARFIELD', category: 'Design', purpose: 'Airport pavements', description: 'Build an aircraft mix, design a section, and check pavement life.', color: 'var(--phase-design)', topics: 'Aircraft · Layers · CDF' },
  { id: 'winjulea', name: 'WinJULEA', category: 'Analysis', purpose: 'Layered elastic analysis', description: 'Apply wheel loads and read stresses, strains, and deflections.', color: 'var(--phase-analysis)', topics: 'Loads · Moduli · Response' },
  { id: 'drip', name: 'DRIP', category: 'Drainage', purpose: 'Subsurface drainage', description: 'Check water inflow, a permeable base, and edgedrain spacing.', color: 'var(--phase-materials)', topics: 'Inflow · Base · Edgedrains' },
  { id: 'pavement-me', name: 'AASHTOWare Pavement ME Design', category: 'Design', purpose: 'Pavement performance', description: 'Set design criteria and compare predicted distress for trial sections.', color: '#dd353c', topics: 'Traffic · Climate · Distress' },
  { id: 'remote-access', name: 'Remote access', category: 'Access', purpose: 'Class Windows workstation', description: 'Connect from a Mac or PC and use the preinstalled course software. Book prolonged sessions in advance.', color: '#e87722', topics: 'CEE-ALQADI-20 · VPN · Windows · macOS · Booking' },
];
---
<SoftwareDocsLayout title="Documentation · CEE 406" description="Software guides, user manuals, and class workstation access for CEE 406." activeModule="index">
  <header class="library-header">
    <h1>Documentation</h1>
    <p>Software guides, user’s manuals, and class workstation access.</p>
  </header>
  <section aria-label="Documentation guides" data-software-library>
    <div class="library-tools" hidden>
      <label class="library-search"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">Find a guide</span><input type="search" placeholder="Find a guide or a topic…" data-software-search autocomplete="off" /></label>
      <div class="library-filters" role="group" aria-label="Filter guides">{['All', 'Design', 'Analysis', 'Drainage', 'Access'].map((category, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-software-filter={category}>{category}</button>)}</div>
    </div>
    <div class="library-results"><h2>Guides</h2><span data-software-count aria-live="polite" aria-atomic="true">{software.length} guides</span></div>
    <div class="library-grid" id="software-guides">
      {software.map(item => <article class="software-card" style={`--software-color: ${item.color}`} data-software-card data-category={item.category} data-search={`${item.name} ${item.category} ${item.purpose} ${item.description} ${item.topics}`.toLowerCase()}>
        <a class="software-card-main" href={`${base}documentation/${item.id}/`} aria-label={`${item.name} guide`}>
          <div class="software-card-art" data-brand={item.id} aria-hidden="true"><div class="software-logo-stage"><img class="software-logo" src={`${base}documentation/branding/${item.id}-logo.${item.id === 'remote-access' ? 'svg' : 'png'}`} width="320" height="160" alt="" decoding="async" /></div>{item.id === 'winjulea' && <span class="software-art-caption">Historical splash screen</span>}</div>
          <div class="software-card-copy"><h3>{item.name}</h3><span class="software-purpose">{item.purpose}</span><p>{item.description}</p><span class="software-open">Open guide <span aria-hidden="true">→</span></span></div>
        </a>
        <div class="software-card-links"><a class="software-manual" href={`${base}documentation/${item.id}/#${item.id === 'remote-access' ? 'start' : item.id === 'faarfield' ? 'exercises' : 'practice'}`}>{item.id === 'remote-access' ? 'Connect' : 'Practice'} <span aria-hidden="true">↗</span></a><a class="software-manual" href={`${base}documentation/${item.id}/#${item.id === 'remote-access' ? 'help' : 'manual'}`}>{item.id === 'remote-access' ? 'Troubleshooting' : 'User’s manual'} <span aria-hidden="true">↗</span></a></div>
      </article>)}
    </div>
    <div class="library-empty" hidden><p>No guides match your search.</p><button type="button" data-software-reset>Clear filters</button></div>
  </section>
  <aside class="library-note"><p>Start with the guide. Use a software manual for command details and version-specific instructions.</p></aside>
</SoftwareDocsLayout>
<script>
  function initSoftwareLibrary() {
    const library = document.querySelector<HTMLElement>('[data-software-library]');
    if (!library || library.dataset.ready) return;
    library.dataset.ready = 'true';
    const input = library.querySelector<HTMLInputElement>('[data-software-search]')!;
    const cards = [...library.querySelectorAll<HTMLElement>('[data-software-card]')];
    const buttons = [...library.querySelectorAll<HTMLButtonElement>('[data-software-filter]')];
    const count = library.querySelector<HTMLElement>('[data-software-count]')!;
    const empty = library.querySelector<HTMLElement>('.library-empty')!;
    let category = 'All';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reveal = (card: HTMLElement, delay = 0) => {
      if (reducedMotion.matches) return;
      card.animate([{ opacity: .25, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 360, delay, easing: 'cubic-bezier(.2,.7,.2,1)' });
    };
    cards.forEach((card, index) => reveal(card, index * 45));
    library.querySelector<HTMLElement>('.library-tools')!.hidden = false;
    const filter = (save = true) => {
      const previous = new Map(cards.filter(card => !card.hidden).map(card => [card, card.getBoundingClientRect()]));
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      cards.forEach(card => {
        card.hidden = !(category === 'All' || category === card.dataset.category) || !terms.every(term => card.dataset.search?.includes(term));
        if (!card.hidden) visible++;
      });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.softwareFilter === category)));
      count.textContent = `${visible} ${visible === 1 ? 'guide' : 'guides'}`;
      empty.hidden = visible !== 0;
      if (save) {
        const url = new URL(location.href);
        input.value.trim() ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
        category !== 'All' ? url.searchParams.set('category', category) : url.searchParams.delete('category');
        history.replaceState(null, '', url);
      }
      cards.filter(card => !card.hidden).forEach(card => {
        if (!previous.has(card)) { reveal(card); return; }
        if (reducedMotion.matches) return;
        const before = previous.get(card)!;
        const after = card.getBoundingClientRect();
        const x = before.left - after.left;
        const y = before.top - after.top;
        if (x || y) card.animate([{ transform: `translate(${x}px, ${y}px)` }, { transform: 'translate(0, 0)' }], { duration: 250, easing: 'cubic-bezier(.2,.7,.2,1)' });
      });
    };
    const restore = () => {
      const params = new URL(location.href).searchParams;
      input.value = params.get('q') ?? '';
      const stored = params.get('category');
      category = buttons.some(button => button.dataset.softwareFilter === stored) ? stored! : 'All';
      filter(false);
    };
    restore();
    window.addEventListener('popstate', restore);
    input.addEventListener('input', () => filter());
    buttons.forEach(button => button.addEventListener('click', () => { category = button.dataset.softwareFilter!; filter(); }));
    library.querySelector('[data-software-reset]')!.addEventListener('click', () => { input.value = ''; category = 'All'; filter(); input.focus(); });
  }
  initSoftwareLibrary();
  document.addEventListener('astro:page-load', initSoftwareLibrary);
</script>
<style>
  .library-header { padding: .5rem 0 2rem; margin-bottom: 1.75rem; border-bottom: 1px solid var(--color-border); }
  .library-header h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0 0 .75rem; letter-spacing: -.04em; }
  .library-header p { max-width: 35rem; font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0; }
  .library-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .library-tools[hidden], [hidden] { display: none !important; }
  .library-search { flex: 1 1 15rem; display: flex; align-items: center; gap: .6rem; border: 1px solid var(--color-border); border-radius: 8px; padding: .65rem .85rem; background: var(--color-surface); }
  .library-search:focus-within { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .library-search svg { width: 1rem; height: 1rem; color: var(--color-text-muted); flex-shrink: 0; }
  .library-search input { border: 0; outline: none; width: 100%; min-width: 0; background: transparent; color: var(--color-text); font: inherit; font-size: .85rem; }
  .library-search input::placeholder { color: var(--color-text-muted); }
  .library-filters { display: flex; flex-wrap: wrap; gap: .25rem; }
  .library-filters button { border: 0; border-bottom: 2px solid transparent; min-height: 44px; padding: .5rem .65rem; background: transparent; color: var(--color-text-muted); font: inherit; font-size: .8rem; cursor: pointer; transition: color .15s ease; }
  .library-filters button:hover { color: var(--color-text); }
  .library-filters button[aria-pressed="true"] { border-bottom-color: var(--color-accent); color: var(--color-text); }
  .library-results { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .85rem; }
  .library-results h2 { font-size: 1rem; margin: 0; }
  .library-results > span { font-family: var(--font-mono); font-size: .7rem; color: var(--color-text-muted); }
  .library-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .software-card { position: relative; border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent); border-radius: 14px; background: var(--software-card-bg, #fff); overflow: hidden; display: flex; flex-direction: column; transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }
  :global([data-theme="dark"]) .software-card { --software-card-bg: #111d30; }
  .software-card:hover, .software-card:focus-within { border-color: color-mix(in srgb, var(--software-color) 55%, var(--color-border)); box-shadow: 0 10px 28px #0000000a; }
  :global([data-theme="dark"]) .software-card:hover, :global([data-theme="dark"]) .software-card:focus-within { box-shadow: 0 10px 28px #00000026; }
  .software-card-main { flex: 1; display: flex; flex-direction: column; border-radius: 14px 14px 0 0; }
  .software-card-main:focus-visible, .software-manual:focus-visible { outline: 2px solid var(--software-color); outline-offset: -4px; }
  .software-card-art { height: 11.5rem; position: relative; isolation: isolate; overflow: hidden; display: grid; place-items: center; padding: 1.5rem; background: linear-gradient(135deg, color-mix(in srgb, var(--software-color) 10%, #f5f7fb), #edf1f7); }
  .software-card-art::before { content: ''; position: absolute; width: 15rem; height: 15rem; border: 1px solid color-mix(in srgb, var(--software-color) 12%, transparent); border-radius: 50%; box-shadow: 0 0 0 28px color-mix(in srgb, var(--software-color) 3%, transparent), 0 0 0 56px color-mix(in srgb, var(--software-color) 2%, transparent); z-index: -1; transform: translate(50%, -15%); }
  .software-logo-stage { display: grid; place-items: center; width: 100%; height: 100%; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .software-art-caption { position: absolute; right: .85rem; bottom: .5rem; font-size: .625rem; color: #53627a; }
  .software-logo { display: block; width: min(100%, 19rem); height: 8rem; object-fit: contain; filter: drop-shadow(0 6px 8px #14223a14); }
  [data-brand="faarfield"] .software-logo { width: 7rem; height: 7rem; }
  [data-brand="drip"] .software-logo { width: 14rem; height: 8.5rem; border-radius: 4px; }
  [data-brand="winjulea"] .software-logo { width: 13rem; height: 9rem; border-radius: 4px; }
  .software-card-main:hover .software-logo-stage, .software-card-main:focus-visible .software-logo-stage { transform: translateY(-3px) scale(1.025); }
  :global([data-theme="dark"]) .software-card-art { background: linear-gradient(135deg, color-mix(in srgb, var(--software-color) 8%, #edf1f7), #e4e9f2); }
  .software-card-copy { padding: 1.4rem 1.5rem 1.25rem; flex: 1; display: flex; flex-direction: column; }
  .software-purpose { font-size: .75rem; color: var(--color-text-muted); margin-bottom: .75rem; }
  .software-card h3 { font-size: 1.0625rem; line-height: 1.4; margin: 0 0 .3rem; color: var(--color-text); }
  .software-card p { font-size: .875rem; color: var(--color-text-muted); line-height: 1.65; margin: 0 0 1.25rem; }
  .software-open { display: flex; justify-content: space-between; align-items: center; font-size: .8rem; font-weight: 500; margin-top: auto; color: var(--color-text); }
  .software-open > span { color: var(--software-color); font-size: 1rem; transition: transform .2s ease; }
  .software-card-main:hover .software-open > span { transform: translateX(3px); }
  .software-manual { display: flex; justify-content: space-between; align-items: center; min-height: 44px; border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent); padding: .65rem 1.5rem; font-size: .75rem; color: var(--color-text-muted); }
  .software-card-links { display: grid; grid-template-columns: 1fr 1fr; }
  .software-card-links .software-manual { gap: .4rem; padding-inline: 1rem; }
  .software-card-links .software-manual + .software-manual { border-left: 1px solid var(--color-border); }
  .software-manual { transition: color .2s ease, background .2s ease; }
  .software-manual > span { transition: transform .2s ease; }
  .software-manual:hover { color: var(--software-color); background: color-mix(in srgb, var(--software-color) 3%, transparent); }
  .software-manual:hover > span, .software-manual:focus-visible > span { transform: translateX(3px); }
  @media (hover: hover) and (pointer: fine) { .software-card:hover { transform: translateY(-3px); } }
  .library-note { margin-top: 1.5rem; padding: .5rem 0; }
  .library-note p { margin: 0; font-size: .8rem; line-height: 1.6; color: var(--color-text-muted); }
  .library-empty { text-align: center; padding: 2rem; border: 1px dashed var(--color-border); border-radius: 10px; color: var(--color-text-muted); font-size: .85rem; }
  .library-empty button { font: inherit; color: var(--color-accent); background: transparent; border: 0; text-decoration: underline; cursor: pointer; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 560px) { .library-grid { grid-template-columns: 1fr; } .library-tools { gap: .5rem; } .library-filters { width: 100%; } .library-filters button { flex: 1 1 auto; } }
  @media (pointer: coarse) { .library-search input { font-size: 1rem; } }
  @media (prefers-reduced-motion: reduce) {
    .software-card, .software-open > span, .software-logo-stage, .software-manual, .software-manual > span, .library-filters button { transition: none; }
    .software-card:hover, .software-card-main:hover .software-open > span, .software-card-main:hover .software-logo-stage, .software-card-main:focus-visible .software-logo-stage, .software-manual:hover > span, .software-manual:focus-visible > span { transform: none; }
  }
</style>
