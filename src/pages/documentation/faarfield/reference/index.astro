---
import SoftwareDocsLayout from '../../../../layouts/SoftwareDocsLayout.astro';
import topics from '../../../../data/faarfield-reference.json';
const base = import.meta.env.BASE_URL;
const groups = [...new Set(topics.map(topic => topic.group))];
const toc = groups.map((label, i) => ({ id: `group-${i}`, label }));
---
<SoftwareDocsLayout title="FAARFIELD reference · CEE 406" description="The imported FAARFIELD help topics and figures." activeModule="reference" toc={toc}>
  <header class="doc-header">
    <h1 class="doc-header__title">FAARFIELD reference</h1>
    <p class="doc-header__desc">Help topics and figures from the supplied FAARFIELD 2.1.1 documentation.</p>
  </header>
  <p class="reference-note">New to the program? Start with the <a href={`${base}documentation/faarfield/`}>course guide</a>. The help text retains its original version labels.</p>
  <label class="topic-filter">Find a topic<input type="search" id="topic-filter" placeholder="Layers, traffic, CDF…" /></label>
  <p id="topic-count" role="status" aria-live="polite">{topics.length} topics</p>
  {groups.map((group, i) => <section id={`group-${i}`} data-section class="doc-section topic-group">
    <h2>{group.replace(/^APPENDIX ([A-E]): /, 'Appendix $1: ')}</h2>
    <ul class="doc-list">
      {topics.filter(topic => topic.group === group).map(topic => <li data-topic={topic.title.toLowerCase()}><a href={`${base}documentation/faarfield/reference/${topic.id}/`}>{topic.title}</a></li>)}
    </ul>
  </section>)}
</SoftwareDocsLayout>
<script>
  const filter = document.querySelector<HTMLInputElement>('#topic-filter');
  filter?.addEventListener('input', () => {
    const query = filter.value.trim().toLowerCase();
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-topic]').forEach(item => {
      item.hidden = !item.dataset.topic?.includes(query);
      if (!item.hidden) count++;
    });
    document.querySelectorAll<HTMLElement>('.topic-group').forEach(group => {
      group.hidden = !group.querySelector('[data-topic]:not([hidden])');
    });
    const status = document.querySelector('#topic-count');
    if (status) status.textContent = count ? `${count} topics` : 'No matching topics.';
  });
</script>
<style>
  .reference-note, #topic-count { font-size: .875rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .reference-note a { color: var(--color-accent); }
  .topic-filter { display: grid; gap: .5rem; font-size: .875rem; }
  .topic-filter input { padding: .65rem .8rem; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-surface); color: var(--color-text); font: inherit; }
  #topic-count { margin-top: .5rem; }
</style>
