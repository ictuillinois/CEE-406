import SoftwareDocsLayout from '../../../layouts/SoftwareDocsLayout.astro';
const base = import.meta.env.BASE_URL;
const headings = ['Setup', 'Model', 'Units', 'Layers', 'Loads', 'Evaluation points', 'Run and save', 'Read the output', 'Example', 'Multiple wheels', 'Sublayers', 'Checks', 'Troubleshooting', 'References'];
