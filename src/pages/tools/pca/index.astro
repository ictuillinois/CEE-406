---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PcaApp from '../../../components/react/pca/PcaApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="PCA Rigid Thickness · CEE 406 Tools"
  description="PCA rigid pavement thickness design — fatigue and erosion damage summed over an axle load distribution, following Huang section 12.2."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">PCA Rigid Thickness</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">PCA Rigid Thickness</h1>
        <p class="tool-head__desc">
          Fatigue and erosion damage summed over an axle load distribution for
          <a href={`${base}homeworks/hw9/`}>HW9</a> Problems 12-3 and 12-4. You read four
          values off the PCA tables; the tool does the summation both criteria need.
        </p>
      </div>
      <div class="tool-head__hws">
        <a href={`${base}homeworks/hw9/`} class="tool-hw-chip">HW9</a>
      </div>
    </header>

    <PcaApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
