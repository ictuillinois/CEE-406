---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Each card gets a small stroke-drawn motif of what the tool computes; the
// main path carries class "anim" and redraws on hover.
const live = [
  {
    name: 'Resilient Modulus Fitter',
    href: `${base}tools/mr-fitter/`,
    color: '#E87722',
    hws: ['HW2'],
    ref: 'MEPDG k₁–k₂–k₃ · Huang Ch. 7',
    desc: 'Fit k₁, k₂, k₃ of the generalized Mr model to triaxial data — live LINEST-style regression with R², a parity plot, and paste-from-Excel input.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M14 6 V38 H112" opacity="0.35" stroke-width="1.5"/>
      <path class="anim" d="M16 33 Q52 24 108 9"/>
      <circle cx="32" cy="31" r="2.4" fill="currentColor" stroke="none"/>
      <circle cx="54" cy="22" r="2.4" fill="currentColor" stroke="none"/>
      <circle cx="76" cy="19" r="2.4" fill="currentColor" stroke="none"/>
      <circle cx="98" cy="10" r="2.4" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    name: 'Stress Explorer',
    href: `${base}tools/stress-explorer/`,
    color: '#0ea5e9',
    hws: ['HW3', 'HW4'],
    ref: 'Boussinesq · Huang Eqs. 2.1–2.6',
    desc: 'One-layer (Boussinesq) response under a circular load: stress, strain, and deflection profiles, a draggable depth probe, and the classic σz/p pressure bulb.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M46 6 H74" stroke-width="4"/>
      <path d="M50 10 Q60 22 70 10" opacity="0.85"/>
      <path d="M44 10 Q60 34 76 10" opacity="0.6"/>
      <path class="anim" d="M37 10 Q60 48 83 10" opacity="0.4"/>
    </svg>`,
  },
  {
    name: 'ESAL Calculator',
    href: `${base}tools/esal-calculator/`,
    color: '#10b981',
    hws: ['HW5', 'HW7'],
    ref: 'AASHTO 1993 · App. D',
    desc: 'Exact AASHTO load equivalency factors, a mixed axle spectrum with presets, and the full design-lane projection — D, L, growth — shown factor by factor.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M14 6 V38 H112" opacity="0.35" stroke-width="1.5"/>
      <path class="anim" d="M16 36 C52 33 84 22 108 7"/>
      <path d="M42 34 l3.2 3.2 3.2-3.2 -3.2-3.2 Z" fill="currentColor" stroke="none"/>
      <path d="M72 27 l3.2 3.2 3.2-3.2 -3.2-3.2 Z" fill="currentColor" stroke="none"/>
      <path d="M94 15 l3.2 3.2 3.2-3.2 -3.2-3.2 Z" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    name: 'AASHTO Design Studio',
    href: `${base}tools/aashto/`,
    color: '#8b5cf6',
    hws: ['HW7', 'HW9'],
    ref: 'AASHTO 1993 · Huang Eqs. 11.34, 12.21, 12.29–12.30',
    desc: 'The 1993 design equations solved in any direction — SN, slab thickness, reliability, roadbed support — with the layered thickness solution and the seasonal effective k.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M14 6 V38 H112" opacity="0.35" stroke-width="1.5"/>
      <path class="anim" d="M18 34 C46 32 74 22 106 8"/>
      <path d="M18 38 C46 36 74 28 106 15" opacity="0.5" stroke-dasharray="3 3"/>
      <circle cx="70" cy="24" r="3.2" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    name: 'Transfer-Function Damage',
    href: `${base}tools/damage/`,
    color: '#8b5cf6',
    hws: ['HW8'],
    ref: 'AASHTOWare transfer functions',
    desc: 'Feed WinJULEA strains through the HW8 transfer functions: rutting per layer, Miner’s damage, and bottom-up cracking growing with every repetition.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M14 12 H106" opacity="0.3" stroke-dasharray="3 4" stroke-width="1.5"/>
      <path class="anim" d="M14 12 C34 12 38 26 60 26 C82 26 86 12 106 12"/>
      <path d="M25 38 C45 38 50 30 60 30 C70 30 75 38 95 38" opacity="0.45"/>
    </svg>`,
  },
  {
    name: 'Westergaard Slab Stress',
    href: `${base}tools/westergaard/`,
    color: '#0ea5e9',
    hws: ['HW9'],
    ref: 'Westergaard · Huang Eqs. 4.11–4.19',
    desc: 'Interior, edge, and corner stresses and deflections for a slab on a Winkler foundation, plus Bradbury curling — with a thickness sensitivity chart.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <rect class="anim" x="22" y="9" width="76" height="26" rx="2"/>
      <circle cx="60" cy="22" r="4" fill="currentColor" stroke="none" opacity="0.9"/>
      <circle cx="60" cy="9" r="4" fill="currentColor" stroke="none" opacity="0.6"/>
      <circle cx="96" cy="33" r="4" fill="currentColor" stroke="none" opacity="0.6"/>
    </svg>`,
  },
  {
    name: 'Pavement LCA Worksheet',
    href: `${base}tools/lca/`,
    color: '#10b981',
    hws: ['HW10'],
    ref: 'FHWA LCA framework',
    desc: 'Life-cycle GHG for one lane-mile across all six stages, with the IRI sawtooth driving the rehab schedule and every inventory factor editable.',
    glyph: `<svg viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M14 9 H106" opacity="0.3" stroke-dasharray="3 4" stroke-width="1.5"/>
      <path class="anim" d="M14 36 L44 9 L44 36 L74 9 L74 36 L104 9"/>
    </svg>`,
  },
];
---

<BaseLayout
  title="Online Tools · CEE 406"
  description="Interactive pavement design tools for CEE 406 homeworks — layered elastic stress analysis, ESAL calculation, and more."
>
  <div class="container tools-page">
    <header class="tools-header gsap-fade-up">
      <span class="tools-header__eyebrow">Online tools</span>
      <h1>The homework toolbox</h1>
      <p>
        Every tool here exists because a homework needs it. They run entirely in your
        browser — nothing to install, nothing to license — and they're built to let you
        check hand calculations, not skip them.
      </p>
    </header>

    <section class="tools-group">
      <div class="tools-group__label gsap-fade-up">
        <span class="tools-live-dot"></span>
        <span>Live now</span>
        <span class="tools-group__rule"></span>
      </div>
      <div class="tools-list stagger-grid">
        {live.map(t => (
          <a href={t.href} class="tl-card gsap-stagger" style={`--tool-color: ${t.color}`}>
            <div class="tl-card__glyph" aria-hidden="true">
              <Fragment set:html={t.glyph} />
            </div>
            <div class="tl-card__head">
              <span class="tl-card__name">{t.name}</span>
              <div class="tl-card__hws">
                {t.hws.map(h => <span class="tl-card__hw">{h}</span>)}
              </div>
            </div>
            <p class="tl-card__desc">{t.desc}</p>
            <div class="tl-card__foot">
              <span class="tl-card__ref">{t.ref}</span>
              <span class="tl-card__cta">Open tool &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .tools-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .tools-header {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .tools-header__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    margin-bottom: 0.625rem;
  }

  .tools-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }

  .tools-header p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .tools-group { margin-bottom: 2.5rem; }

  .tools-group__label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
  }

  .tools-live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
  }

  .tools-group__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .tools-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.875rem;
  }

  .tl-card {
    display: flex;
    flex-direction: column;
    padding: 1.375rem 1.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.tl-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--tool-color, var(--color-accent));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  a.tl-card:hover {
    border-color: var(--tool-color, var(--color-accent));
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 26, 46, 0.08);
  }

  a.tl-card:hover::before { opacity: 1; }

  :global([data-theme="dark"]) .tl-card {
    background: #162033;
    border-color: #2D3F59;
  }

  .tl-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }

  .tl-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .tl-card__hws { display: flex; gap: 0.3rem; }

  .tl-card__hw {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border-radius: 4px;
    padding: 0.12rem 0.4rem;
  }

  .tl-card__desc {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  /* Glyph strip: a stroke-drawn motif of what the tool computes */
  .tl-card__glyph {
    color: var(--tool-color, var(--color-accent));
    background: color-mix(in srgb, var(--tool-color, var(--color-accent)) 7%, transparent);
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    margin-bottom: 0.875rem;
  }

  .tl-card__glyph :global(svg) {
    display: block;
    width: 100%;
    height: 54px;
    transition: transform 0.25s ease;
  }

  a.tl-card:hover .tl-card__glyph :global(svg) {
    transform: translateY(-1px) scale(1.02);
  }

  @keyframes tl-draw {
    from { stroke-dasharray: 320; stroke-dashoffset: 320; }
    to { stroke-dasharray: 320; stroke-dashoffset: 0; }
  }

  a.tl-card:hover .tl-card__glyph :global(path.anim),
  a.tl-card:hover .tl-card__glyph :global(rect.anim) {
    animation: tl-draw 0.9s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-card__glyph :global(svg),
    a.tl-card:hover .tl-card__glyph :global(path.anim),
    a.tl-card:hover .tl-card__glyph :global(rect.anim) {
      transition: none;
      animation: none;
    }
  }

  .tl-card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tl-card__ref {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .tl-card__cta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
