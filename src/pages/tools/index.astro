---
import BaseLayout from '../../layouts/BaseLayout.astro';

import Icon from '../../components/Icon.astro';
import { tools, toolHref } from '../../data/tools';
import { toolLock } from '../../data/release';

const base = import.meta.env.BASE_URL;

// Two lists, one source. A locked tool keeps its card — knowing the toolbox
// exists is part of seeing the shape of the course — but it has no link, and
// its page is not built at all (its index.astro is renamed _index.astro, which
// Astro does not route). release.test.mjs asserts those two facts agree.
const live = tools.filter(t => toolLock(t.slug).released);
const locked = tools.filter(t => !toolLock(t.slug).released);
---

<BaseLayout
  title="Online Tools · CEE 406"
  description="Interactive pavement design tools for CEE 406 homeworks — layered elastic stress analysis, ESAL calculation, and more."
>
  <div class="container tools-page">
    <header class="tools-header gsap-fade-up">
      <span class="tools-header__eyebrow">Online tools</span>
      <h1>The homework toolbox</h1>
      <p>
        Every tool here exists because a homework needs it — most of them to compute
        something, one of them to draw the figure the write-up asks for. They run entirely
        in your browser — nothing to install, nothing to license — and the calculators are
        built to let you check hand calculations, not skip them.
      </p>
      {locked.length > 0 && (
        <p class="tools-header__release">
          {live.length} of {tools.length} are open. The rest unlock alongside the homework
          that needs them, so the toolbox grows with the course rather than arriving all at
          once.
        </p>
      )}
    </header>

    <section class="tools-group">
      <div class="tools-group__label gsap-fade-up">
        <span class="tools-live-dot"></span>
        <span>Live now</span>
        <span class="tools-group__rule"></span>
      </div>
      <div class="tools-list stagger-grid">
        {live.map(t => (
          <a href={toolHref(base, t)} class="tl-card tl-card--shot gsap-stagger" style={`--tool-color: ${t.color}`}>
            {t.image
              ? <div class="tl-card__shot">
                  <img
                    src={`${base}tools/${t.image}`}
                    alt={t.imageAlt ?? ''}
                    loading="lazy" decoding="async"
                  />
                </div>
              : <div class="tl-card__glyph" aria-hidden="true">
                  <Fragment set:html={t.glyph} />
                </div>}
            <div class="tl-card__head">
              <span class="tl-card__name">{t.name}</span>
              <div class="tl-card__hws">
                {t.hws.map(h => <span class="tl-card__hw">{h}</span>)}
              </div>
            </div>
            <p class="tl-card__desc">{t.desc}</p>
            <div class="tl-card__foot">
              <span class="tl-card__ref">{t.ref}</span>
              <span class="tl-card__cta">Open tool &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {locked.length > 0 && (
      <section class="tools-group">
        <div class="tools-group__label gsap-fade-up">
          <span class="tools-locked-dot"></span>
          <span>Unlocks later</span>
          <span class="tools-group__rule"></span>
        </div>
        <div class="tools-list stagger-grid">
          {locked.map(t => (
            <div class="tl-card tl-card--locked gsap-stagger" style={`--tool-color: ${t.color}`} aria-disabled="true">
              <div class="tl-card__glyph" aria-hidden="true">
                <Fragment set:html={t.glyph} />
              </div>
              <div class="tl-card__head">
                <span class="tl-card__name">{t.name}</span>
                <div class="tl-card__hws">
                  {t.hws.map(h => <span class="tl-card__hw">{h}</span>)}
                </div>
              </div>
              <p class="tl-card__desc">{t.desc}</p>
              <div class="tl-card__foot">
                <span class="tl-card__ref">{t.ref}</span>
                <span class="tl-card__locked"><Icon name="lock" size={12} />{toolLock(t.slug).label}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .tools-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .tools-header {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .tools-header__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    margin-bottom: 0.625rem;
  }

  .tools-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }

  .tools-header p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .tools-group { margin-bottom: 2.5rem; }

  .tools-group__label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
  }

  .tools-live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
  }

  /* Hollow, where "live" is filled and glowing. Same size, same position, so
     the two group headings read as one scale rather than two decorations. */
  .tools-locked-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid var(--color-text-muted);
    opacity: 0.7;
  }

  .tools-group__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .tools-header__release {
    margin-top: 0.875rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    background: var(--color-surface-alt);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* A locked tool card is a <div>: not focusable, not clickable. The dim is
     what carries the state; the glyph keeps its colour so the card still
     reads as that particular tool rather than as a grey placeholder. */
  /* .gsap-stagger animates inline opacity on these, so the locked state uses
     filter + muted text instead — see the note on .hw-row--locked. */
  .tl-card--locked {
    cursor: default;
    border-style: dashed;
    filter: grayscale(0.75);
  }

  .tl-card--locked .tl-card__name,
  .tl-card--locked .tl-card__desc { color: var(--color-text-muted); }

  .tl-card--locked .tl-card__glyph { opacity: 0.6; }

  .tl-card--locked:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--color-border);
  }

  .tl-card__locked {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  /* A live tool with a screenshot leads with it — same capture the landing page
     and the E-Labs site use. The card keeps its padding for the text but the
     shot runs full-bleed to the card edge, so the image reads as the subject
     rather than as an illustration inside a box. */
  /* Two classes, not one: `.tl-card` sets `padding` as a shorthand and is
     declared later in this sheet, so a single-class override loses to it and
     the shot sat inset by 1.5rem instead of running to the card edge. */
  .tl-card.tl-card--shot { padding-top: 0; padding-left: 0; padding-right: 0; }
  .tl-card.tl-card--shot > :not(.tl-card__shot) { padding-left: 1.5rem; padding-right: 1.5rem; }

  .tl-card__shot {
    position: relative;
    /* 16:9 sits between the two captures (1.66 and 1.91), so neither is
       cropped much: the Gear3D render loses a little empty grid top and
       bottom, the Cross-Section screenshot a sliver of each side rail.
       A single ratio matters more than a perfect fit — two cards side by
       side with different heights read as a mistake. */
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .tl-card__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tl-card--shot:hover .tl-card__shot img { transform: scale(1.035); }

  .tl-card__shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--tool-color, var(--color-accent)) 12%, transparent),
      transparent 55%
    );
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .tl-card--shot:hover .tl-card__shot::after { opacity: 0; }

  :global([data-theme="dark"]) .tl-card__shot {
    background: #0D1526;
    border-bottom-color: #2D3F59;
  }

  .tools-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.875rem;
  }

  .tl-card {
    display: flex;
    flex-direction: column;
    padding: 1.375rem 1.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.tl-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--tool-color, var(--color-accent));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  a.tl-card:hover {
    border-color: var(--tool-color, var(--color-accent));
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 26, 46, 0.08);
  }

  a.tl-card:hover::before { opacity: 1; }

  :global([data-theme="dark"]) .tl-card {
    background: #162033;
    border-color: #2D3F59;
  }

  .tl-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }

  .tl-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .tl-card__hws { display: flex; gap: 0.3rem; }

  .tl-card__hw {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border-radius: 4px;
    padding: 0.12rem 0.4rem;
  }

  .tl-card__desc {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  /* Glyph strip: a stroke-drawn motif of what the tool computes */
  .tl-card__glyph {
    color: var(--tool-color, var(--color-accent));
    background: color-mix(in srgb, var(--tool-color, var(--color-accent)) 7%, transparent);
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    margin-bottom: 0.875rem;
  }

  .tl-card__glyph :global(svg) {
    display: block;
    width: 100%;
    height: 54px;
    transition: transform 0.25s ease;
  }

  a.tl-card:hover .tl-card__glyph :global(svg) {
    transform: translateY(-1px) scale(1.02);
  }

  @keyframes tl-draw {
    from { stroke-dasharray: 320; stroke-dashoffset: 320; }
    to { stroke-dasharray: 320; stroke-dashoffset: 0; }
  }

  a.tl-card:hover .tl-card__glyph :global(path.anim),
  a.tl-card:hover .tl-card__glyph :global(rect.anim) {
    animation: tl-draw 0.9s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-card__glyph :global(svg),
    a.tl-card:hover .tl-card__glyph :global(path.anim),
    a.tl-card:hover .tl-card__glyph :global(rect.anim) {
      transition: none;
      animation: none;
    }
  }

  .tl-card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tl-card__ref {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .tl-card__cta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
