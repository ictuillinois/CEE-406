---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackcalcApp from '../../../components/react/backcalc/BackcalcApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="FWD Backcalculation Studio · CEE 406 Tools"
  description="Backcalculate layer moduli from a measured falling-weight deflection basin, by layered-elastic inversion and by the AASHTO 1993 closed form — with the sensitivity that tells you which moduli the data actually determines."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">FWD Backcalculation</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">FWD Backcalculation Studio</h1>
        <p class="tool-head__desc">
          Run the forward problem backwards. A measured deflection basin goes in; layer moduli
          come out — by full layered-elastic inversion and by the AASHTO 1993 closed form, which
          will not agree. The tool also reports which of those moduli the basin actually
          determines and which are your seed guess in disguise
          (<a href={`${base}textbook/ch09/`}>Ch. 9 §9.4</a>,
          <a href={`${base}textbook/ch13/`}>Ch. 13 §13.5</a>).
        </p>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip">Ch. 9 · 13</span>
      </div>
    </header>

    <BackcalcApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
