---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReliabilityApp from '../../../components/react/reliability/ReliabilityApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Reliability & Variability Explorer · CEE 406 Tools"
  description="Turn a deterministic AASHTO flexible design into a probabilistic one: propagate the variance of every input, rank what dominates the uncertainty, and compare Taylor, Rosenblueth, and Monte Carlo estimates of reliability."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Reliability &amp; Variability</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Reliability &amp; Variability Explorer</h1>
        <p class="tool-head__desc">
          Every input to a pavement design is a distribution, not a number. This tool propagates
          those distributions through the AASHTO flexible equation, reports which input owns the
          uncertainty, and runs the same question three ways — Taylor's expansion, Rosenblueth's
          point estimates, and Monte Carlo — so you can see where the assumptions break
          (<a href={`${base}textbook/ch10/`}>Ch. 10</a>).
        </p>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip">Ch. 10</span>
      </div>
    </header>

    <ReliabilityApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
