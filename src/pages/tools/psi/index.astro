---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PsiApp from '../../../components/react/psi/PsiApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Serviceability & Skid Resistance · CEE 406 Tools"
  description="Compute PSI from roughness, rutting and cracking, fit your own PSI equation to panel ratings, and read skid number against speed — the empirical foundation every design equation in the course rests on."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Serviceability &amp; Skid</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Serviceability &amp; Skid Resistance</h1>
        <p class="tool-head__desc">
          Where the empirical tradition comes from. Fit the PSI equation yourself to a rating panel
          and watch the rut coefficient come out <strong>27× the published value with an R² above
          0.98</strong> — the most honest introduction to regression a pavement course can offer.
          Plus skid number against speed, which is two independent properties wearing one number
          (<a href={`${base}textbook/ch09/`}>Ch. 9 §9.2–9.3</a>).
        </p>
      </div>
      <div class="tool-head__hws">
        <a href={`${base}homeworks/hw1/`} class="tool-hw-chip">HW1</a>
        <a href={`${base}homeworks/hw10/`} class="tool-hw-chip">HW10</a>
      </div>
    </header>

    <PsiApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page { padding-top: 2rem; padding-bottom: 5rem; }
  .tool-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 1.5rem; margin-bottom: 1.75rem; flex-wrap: wrap;
  }
  .tool-head__title { font-size: clamp(1.625rem, 3.5vw, 2.25rem); margin: 0 0 0.5rem; }
  .tool-head__desc {
    font-size: 0.9rem; line-height: 1.65; color: var(--color-text-muted);
    max-width: 44rem; margin: 0;
  }
  .tool-head__desc a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .tool-head__hws { display: flex; gap: 0.4rem; }
  .tool-hw-chip {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
    color: var(--color-accent); background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2); border-radius: 6px;
    padding: 0.3rem 0.55rem; text-decoration: none; transition: background 0.15s ease;
  }
  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
