---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WestergaardApp from '../../../components/react/westergaard/WestergaardApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Westergaard Slab Stress · CEE 406 Tools"
  description="Every published Westergaard case for a concrete slab on a Winkler foundation — interior, edge under circular and semicircular contact, and corner by two disagreeing formulas — plus Bradbury curling and the dual-tire equivalent circle. For CEE 406 HW9."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Westergaard Slab Stress</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Westergaard Slab Stress</h1>
        <p class="tool-head__desc">
          Every published Westergaard case for <a href={`${base}homeworks/hw9/`}>HW9</a> — interior,
          edge under both circular <em>and</em> semicircular contact, and corner by both the original
          and the Ioannides formulas. The last two pairs disagree, and the tool shows both rather
          than picking for you. Plus Bradbury curling and the dual-tire equivalent circle
          (Huang Ch. 4, Eqs. 4.9–4.31), pinned to the printed answers of Examples 4.1–4.5.
        </p>
      </div>
      <div class="tool-head__hws">
        <a href={`${base}homeworks/hw9/`} class="tool-hw-chip">HW9</a>
      </div>
    </header>

    <WestergaardApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
