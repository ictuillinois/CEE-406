---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeapsApp from '../../../components/react/leaps/LeapsApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="LEAPS · Layered Elastic Analysis of Pavement Structures · CEE 406 Tools"
  description="A full N-layer elastic pavement analysis program in the browser: point, line and circular loads, bonded to frictionless interfaces, live stress bulbs, and results in WinJULEA's own row order and conventions."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">LEAPS</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">LEAPS</h1>
        <p class="tool-head__desc">
          Linear elastic analysis of pavement structures: any number of layers, interfaces
          from fully bonded to frictionless, multi-wheel gears, and the same total load
          applied as a <strong>circular imprint</strong>, a <strong>point load</strong> or a
          <strong>line load</strong>. Results in <strong>WinJULEA</strong>'s row order and
          sign conventions.
        </p>
      </div>
      <div class="tool-head__hws">
        <a href={`${base}homeworks/hw3/`} class="tool-hw-chip">HW3</a>
        <a href={`${base}homeworks/hw4/`} class="tool-hw-chip">HW4</a>
        <span class="tool-hw-chip tool-hw-chip--static">Ch. 2</span>
      </div>
    </header>

    <LeapsApp client:only="react" />
  </div>
</BaseLayout>

<style>
  /* The workspace is a three-column CAD shell: a 300px model rail, a
     viewport, and a 320px results rail, over a full-width dock. At the
     site's 1280px container that leaves the viewport under 500px wide,
     which is narrower than the standalone page and narrow enough that the
     section stops being readable. This page, and only this page, opens the
     container out to the width the app was drawn for.

     `min()` rather than a bare max-width: the container's own 1.5rem side
     padding has to survive, or the card runs into the window edge on a
     laptop screen between the two figures. */
  .tool-page {
    max-width: min(1680px, 100vw);
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
    letter-spacing: 0.01em;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 52rem;
    margin: 0;
  }

  .tool-head__desc strong { color: var(--color-text); font-weight: 600; }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }

  .tool-hw-chip--static {
    color: var(--color-text-muted);
    background: transparent;
    border-color: var(--color-border);
    cursor: default;
  }

  .tool-hw-chip--static:hover { background: transparent; }
</style>
