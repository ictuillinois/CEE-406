---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeapsApp from '../../../components/react/leaps/LeapsApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="LEAPS · Layered Elastic Analysis of Pavement Structures · CEE 406 Tools"
  description="A full N-layer elastic pavement analysis program in the browser: point, line and circular loads, bonded to frictionless interfaces, live stress bulbs, and results in WinJULEA's own row order and conventions."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">LEAPS</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">LEAPS — Linear Elastic Analysis of Pavement Structures</h1>
        <p class="tool-head__desc">
          A complete layered-elastic analysis program: any number of layers, interfaces
          from fully bonded to frictionless, multi-wheel gears, and the same total load
          applied as a <strong>circular imprint</strong>, a <strong>point load</strong> or a
          <strong>line load</strong>. Stresses, strains, displacements and principal values
          at every evaluation point, in <strong>WinJULEA</strong>'s row order and sign
          conventions, so a run here can be read straight across from one there.
        </p>
      </div>
      <div class="tool-head__hws">
        <a href={`${base}homeworks/hw3/`} class="tool-hw-chip">HW3</a>
        <a href={`${base}homeworks/hw4/`} class="tool-hw-chip">HW4</a>
        <span class="tool-hw-chip tool-hw-chip--static">Ch. 2</span>
      </div>
    </header>

    <LeapsApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 46rem;
    margin: 0;
  }

  .tool-head__desc strong { color: var(--color-text); font-weight: 600; }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }

  .tool-hw-chip--static {
    color: var(--color-text-muted);
    background: transparent;
    border-color: var(--color-border);
    cursor: default;
  }

  .tool-hw-chip--static:hover { background: transparent; }
</style>
