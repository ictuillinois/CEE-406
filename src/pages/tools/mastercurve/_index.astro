---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MasterCurveApp from '../../../components/react/mastercurve/MasterCurveApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Dynamic Modulus & Master Curve · CEE 406 Tools"
  description="Predict the dynamic modulus of an asphalt mixture by the Asphalt Institute and Shell/Bonnaure routes, then collapse the isotherms onto a master curve by time-temperature superposition — and see how well superposition actually holds."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Dynamic Modulus &amp; Master Curve</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Dynamic Modulus &amp; Master Curve</h1>
        <p class="tool-head__desc">
          Asphalt is not a material with a modulus; it is a material with a modulus <em>at a
          temperature and a loading rate</em>. This tool predicts |E*| by two published routes that
          disagree, then shifts the isotherms onto one master curve and reports how well time–
          temperature superposition actually holds — which is a question, not an assumption
          (<a href={`${base}textbook/ch07/`}>Ch. 7 §7.2</a>,
          <a href={`${base}textbook/ch02/`}>Ch. 2 §2.3</a>,
          <a href={`${base}textbook/appendix-a/`}>App. A</a>).
        </p>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip">Ch. 7 · 2 · App. A</span>
      </div>
    </header>

    <MasterCurveApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page { padding-top: 2rem; padding-bottom: 5rem; }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tool-hw-chip:hover { background: rgba(232, 119, 34, 0.15); }
</style>
