---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrossSectionApp from '../../../components/react/crosssection/CrossSectionApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Cross-Section Studio · CEE 406 Tools"
  description="Build a publication-quality 3-D pavement cross section — eighteen procedural materials, true-to-scale layer thicknesses, thirteen airfield and highway templates — and copy the PNG straight to your clipboard."
>
  <div class="container tool-page tool-page--wide">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Cross-Section Studio</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Cross-Section Studio</h1>
        <p class="tool-head__desc">
          The figure every homework write-up needs and nobody wants to redraw: a true-to-scale
          3-D pavement section with real layer thicknesses and eighteen procedural materials —
          FAA <span class="tool-head__nowrap">P-401</span> through <span class="tool-head__nowrap">P-501</span>,
          SMA, OGFC, CTB, FDR, open-graded stone, clay and weathered rock. Build it, frame it,
          and <strong>copy the PNG straight to your clipboard</strong> — with or without a
          background — instead of hunting for a downloaded file.
        </p>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip tool-hw-chip--static">18 materials</span>
        <span class="tool-hw-chip tool-hw-chip--static">13 templates</span>
      </div>
    </header>

    <CrossSectionApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  /* The studio is a three-column shell — 268px rail, viewport, 292px rail —
     and at the site's 1280px measure the viewport is left with about 690px.
     A little more width is the difference between framing a section and
     squinting at it, so this page alone runs wider than the text measure. */
  .tool-page--wide { max-width: 1480px; }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc strong { color: var(--color-text); font-weight: 600; }
  .tool-head__nowrap { white-space: nowrap; }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    white-space: nowrap;
  }

  /* On a handheld the masthead is what stands between the reader and the
     tool. Measured at 390px the viewport started 600px down the page; this
     gives back about a fifth of that without dropping anything. */
  @media (max-width: 719px) {
    .tool-page { padding-top: 1.25rem; }
    .tool-head { margin-bottom: 1rem; gap: 0.75rem; }
    .tool-head__title { font-size: 1.5rem; margin-bottom: 0.35rem; }
    .tool-head__desc { font-size: 0.83rem; line-height: 1.55; }
    .tool-head__hws { order: -1; }
  }
</style>
