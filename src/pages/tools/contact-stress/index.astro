---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactStressApp from '../../../components/react/contactstress/ContactStressApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contact Stress Visualizer · CEE 406 Tools"
  description="Three-dimensional tire–pavement contact stresses from phyContactGAN (Lang, Villamil & Al-Qadi 2026), against the uniform-circle idealization of Huang §1.3. Vertical, longitudinal and transverse fields for a dual assembly or a wide-base tire, live."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Contact Stress Visualizer</span>
    </nav>

    <header class="tool-head">
      <div class="tool-head__main">
        <h1 class="tool-head__title">Contact Stress Visualizer</h1>
        <p class="tool-head__desc">
          Every method in this course starts by assuming a truck tire presses on the
          pavement as a uniform pressure equal to its inflation pressure, over a circle of
          area <em>P</em>/<em>p</em>. It does not. This tool shows what it actually does.
        </p>

        <aside class="tool-cite" aria-label="Source publication">
          <p class="tool-cite__lead">
            Every field on this page is predicted by <strong>phyContactGAN</strong>, developed at
            the Illinois Center for Transportation. Further details can be found in:
          </p>
          <p class="tool-cite__ref">
            Lang, H., Villamil, W. D., &amp; Al-Qadi, I. L. (2026). 3D tire–pavement contact
            stresses: physics-informed prediction approach. <em>International Journal of
            Pavement Engineering</em>, 27(1), 2621970.
            <a href="https://doi.org/10.1080/10298436.2026.2621970" target="_blank" rel="noreferrer">
              doi:10.1080/10298436.2026.2621970
            </a>
          </p>
        </aside>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip">HW3</span>
        <span class="tool-hw-chip">HW4</span>
        <span class="tool-hw-chip">Ch. 1</span>
      </div>
    </header>

    <ContactStressApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__main {
    flex: 1 1 30rem;
    min-width: 0;
  }

  /* The physics on this page is not the course's — it is a published model, and
     the credit belongs beside the claim, not in a footnote at the bottom of a
     long scroll. Accent rule + raised surface so it reads as attribution rather
     than as more prose. */
  .tool-cite {
    max-width: 44rem;
    margin: 1rem 0 0;
    padding: 0.75rem 0.9rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    background: var(--color-surface-alt);
  }

  .tool-cite__lead {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .tool-cite__ref {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tool-cite a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-word;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
  }
</style>
