---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactStressApp from '../../../components/react/contactstress/ContactStressApp';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contact Stress Visualizer · CEE 406 Tools"
  description="Three-dimensional tyre–pavement contact stresses from phyContactGAN (Lang, Villamil & Al-Qadi 2026), against the uniform-circle idealisation of Huang §1.3. Vertical, longitudinal and transverse fields for a dual assembly or a wide-base tyre, live."
>
  <div class="container tool-page">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="doc-breadcrumb__sep">/</span>
      <a href={`${base}tools/`}>Tools</a>
      <span class="doc-breadcrumb__sep">/</span>
      <span class="doc-breadcrumb__current">Contact Stress Visualizer</span>
    </nav>

    <header class="tool-head">
      <div>
        <h1 class="tool-head__title">Contact Stress Visualizer</h1>
        <p class="tool-head__desc">
          Every method in this course starts by assuming a truck tyre presses on the
          pavement as a uniform pressure equal to its inflation pressure, over a circle of
          area <em>P</em>/<em>p</em>. It does not. This tool shows what it actually does —
          the vertical, longitudinal and transverse contact stresses in three dimensions —
          from <a href="https://doi.org/10.1080/10298436.2026.2621970" target="_blank" rel="noreferrer">phyContactGAN</a>,
          a physics-informed network trained at ICT on 1,852 validated finite-element
          simulations, and then measures the difference against the idealisation you will
          use in <a href={`${base}homeworks/hw3/`}>HW3</a> and <a href={`${base}homeworks/hw4/`}>HW4</a>.
        </p>
      </div>
      <div class="tool-head__hws">
        <span class="tool-hw-chip">HW3</span>
        <span class="tool-hw-chip">HW4</span>
        <span class="tool-hw-chip">Ch. 1</span>
      </div>
    </header>

    <ContactStressApp client:only="react" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .tool-head__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .tool-head__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin: 0;
  }

  .tool-head__desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-head__hws { display: flex; gap: 0.4rem; }

  .tool-hw-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
  }
</style>
