---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LayerGlyph from '../../components/LayerGlyph.astro';
import Icon from '../../components/Icon.astro';
import { homeworks, phases } from '../../data/homeworks';
import { homeworkLock, releasedHomeworkCount } from '../../data/release';

const base = import.meta.env.BASE_URL;
const liveCount = releasedHomeworkCount();
const byPhase = phases
  .map(phase => ({ phase, items: homeworks.filter(h => h.phase === phase) }))
  .filter(g => g.items.length > 0);
---

<BaseLayout
  title="Homeworks · CEE 406"
  description="All ten CEE 406 homework assignments with due dates, related textbook chapters, online tools, and downloadable handouts."
>
  <div class="container hw-page">
    <header class="hw-header gsap-fade-up">
      <span class="hw-header__eyebrow">CEE 406 &middot; Fall 2024 reference schedule</span>
      <h1>Homeworks</h1>
      <p>
        Ten assignments trace the arc of the course: what pavements are, what they're made of,
        how they carry load, and how they're designed. Every homework links the tools and
        chapters you need — start at the assignment, and everything else is one click away.
      </p>
      <p class="hw-header__release">
        {liveCount === 0
          ? 'Assignments are released as the semester reaches them. The full sequence is listed below so you can see what is coming; each one opens on its release date.'
          : `${liveCount} of ${homeworks.length} released so far — the rest open as the semester reaches them.`}
      </p>
    </header>

    {byPhase.map(group => (
      <section class="hw-phase" data-phase={group.phase}>
        <div class="hw-phase__label gsap-fade-up">
          <span class="hw-phase__name">{group.phase}</span>
          <span class="hw-phase__rule"></span>
        </div>
        <div class="hw-rows">
          {group.items.map(hw => {
            const lock = homeworkLock(hw.id);
            const Row = lock.released ? 'a' : 'div';
            return (
            <Row
              href={lock.released ? `${base}homeworks/${hw.id}/` : undefined}
              class:list={['hw-row', 'gsap-fade-up', { 'hw-row--locked': !lock.released }]}
              data-phase={hw.phase}
              aria-disabled={lock.released ? undefined : 'true'}
            >
              <div class="hw-row__id">
                <LayerGlyph focus={hw.layerFocus} />
                <span class="hw-row__num">HW{hw.num}</span>
              </div>
              <div class="hw-row__body">
                <h2 class="hw-row__title">{hw.title}</h2>
                <p class="hw-row__desc">{hw.overview}</p>
                <div class="hw-row__meta">
                  {lock.released && (
                    <span class="hw-row__due"><Icon name="calendar" size={13} />Due {hw.due}</span>
                  )}
                  <span class="hw-row__fact"><Icon name="file" size={13} />{hw.problems.length} problems</span>
                  {hw.chapters.length > 0 && (
                    <span class="hw-row__fact">
                      <Icon name="layers" size={13} />
                      {hw.chapters.map(c => c.label.split(' — ')[0]).join(', ')}
                    </span>
                  )}
                  {lock.released && hw.tools.some(t => t.href) && (
                    <span class="hw-row__live"><Icon name="sliders" size={12} />tool online</span>
                  )}
                </div>
              </div>
              {lock.released
                ? <Icon name="arrow-right" size={20} class="hw-row__arrow" />
                : <span class="hw-row__lock"><Icon name="lock" size={13} />{lock.label}</span>}
            </Row>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .hw-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .hw-header {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .hw-header__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    margin-bottom: 0.625rem;
  }

  .hw-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }

  .hw-header p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  /* ── Phase groups ── */
  .hw-phase {
    margin-bottom: 2.25rem;
  }

  .hw-phase__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }

  .hw-phase__name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--phase, var(--color-text-muted));
    flex-shrink: 0;
  }

  /* A dot in the phase hue, so the five groups are distinguishable while
     scrolling past at speed rather than only when read. */
  .hw-phase__name::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--phase, var(--color-accent));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--phase, var(--color-accent)) 20%, transparent);
  }

  .hw-phase__rule {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--phase, var(--color-border)) 35%, transparent),
      var(--color-border) 40%
    ) !important;
  }

  .hw-phase__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .hw-rows {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  /* ── Rows ── */
  .hw-row {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.125rem 1.375rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* A vertical rail in the phase hue. It grows from a hairline to the full
     row height on hover, which gives the list a sense of being handled. */
  .hw-row::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 3px;
    height: 28%;
    transform: translateY(-50%);
    border-radius: 0 3px 3px 0;
    background: var(--phase, var(--color-accent));
    opacity: 0.5;
    transition: height 0.25s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
  }

  .hw-row:hover::before { height: 100%; opacity: 1; }

  .hw-row:hover {
    border-color: var(--phase, var(--color-accent));
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(15, 26, 46, 0.07);
  }

  :global([data-theme="dark"]) .hw-row {
    background: #162033;
    border-color: #2D3F59;
  }

  :global([data-theme="dark"]) .hw-row:hover {
    border-color: var(--phase, var(--color-accent));
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  /* ── Not released yet ───────────────────────────────────────────────────
     A locked row is a <div>, not an <a>, so it is already unreachable by
     keyboard and by click. The styling only has to make that legible: the
     phase rail and the hover lift are removed, so nothing invites a click,
     and the whole row is dimmed rather than grayed to a different hue —
     it is the same row, just not open yet. */
  /* NOTE: do NOT dim these with `opacity`. Every row carries .gsap-fade-up,
     and GSAP animates opacity as an INLINE style — which beats any class rule
     here, so the locked state silently rendered at full strength. `filter` is
     not touched by that animation, and muting the text directly cannot be
     overridden by it either. */
  .hw-row--locked {
    cursor: default;
    border-style: dashed;
    filter: grayscale(0.7);
  }

  .hw-row--locked .hw-row__title,
  .hw-row--locked .hw-row__desc,
  .hw-row--locked .hw-row__fact { color: var(--color-text-muted); }

  .hw-row--locked .hw-row__id { filter: grayscale(1); opacity: 0.55; }

  .hw-row--locked:hover {
    border-color: var(--color-border);
    transform: none;
    box-shadow: none;
  }

  .hw-row--locked:hover::before { height: 0; opacity: 0; }

  :global([data-theme="dark"]) .hw-row--locked:hover {
    border-color: #2D3F59;
    box-shadow: none;
  }

  .hw-row__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: none;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
  }

  .hw-header__release {
    margin-top: 0.875rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    background: var(--color-surface-alt);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hw-row__id {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-top: 0.15rem;
    width: 3rem;
    flex-shrink: 0;
  }

  .hw-row__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .hw-row__body { flex: 1; min-width: 0; }

  .hw-row__title {
    font-size: 1.0625rem;
    margin: 0 0 0.3rem;
  }

  .hw-row__desc {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 0.55rem;
  }

  /* Icons replace the middot separators: each fact now says what it IS
     before you read it, and the row scans in one pass instead of two. */
  .hw-row__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .hw-row__due,
  .hw-row__fact {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
  }

  .hw-row__due {
    font-weight: 600;
    color: var(--color-text);
  }

  .hw-row__due :global(.icon) { color: var(--phase, var(--color-accent)); }

  .hw-row__live {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0f7a57;
    background: rgba(16, 185, 129, 0.10);
    border-radius: 5px;
    padding: 0.16rem 0.45rem;
  }

  :global([data-theme="dark"]) .hw-row__live {
    color: #4FC79E;
    background: rgba(79, 199, 158, 0.14);
  }

  :global(.hw-row__arrow) {
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-top: 0.35rem;
    opacity: 0.45;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                color 0.2s ease, opacity 0.2s ease;
  }

  .hw-row:hover :global(.hw-row__arrow),
  .hw-row:focus-visible :global(.hw-row__arrow) {
    transform: translateX(4px);
    color: var(--phase, var(--color-accent));
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-row, .hw-row::before { transition: none; }
    .hw-row:hover { transform: none; }
    :global(.hw-row__arrow) { transition: none; }
    .hw-row:hover :global(.hw-row__arrow) { transform: none; }
  }

  @media (max-width: 560px) {
    .hw-row { gap: 0.875rem; padding: 1rem; }
    .hw-row__id { width: 2.25rem; }
  }
</style>
