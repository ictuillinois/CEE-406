---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chapters, appendices } from '../../data/textbook';
import { TEXTBOOK_LIBRARY_URL, TEXTBOOK_CITATION } from '../../data/release';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Textbook · CEE 406"
  description="The reading map for CEE 406 — what each chapter of Huang, Pavement Analysis and Design (2004) covers, which homeworks it backs, and where to borrow the book from the University Library."
>
  <div class="container tb-page">
    <header class="tb-header gsap-fade-up">
      <span class="tb-header__eyebrow">Course textbook</span>
      <h1>Pavement Analysis and Design</h1>
      <p class="tb-header__byline">Yang H. Huang &middot; 2nd edition, 2004 &middot; Pearson</p>
      <p class="tb-header__desc">
        The reading map for the course: what each chapter covers and which homeworks it
        backs. The book itself is not hosted here — it is a copyrighted commercial text,
        and the University Library is where you get it.
      </p>
      <div class="tb-header__source">
        <p class="tb-header__cite">{TEXTBOOK_CITATION}</p>
        <a href={TEXTBOOK_LIBRARY_URL} target="_blank" rel="noopener" class="btn btn-primary tb-header__cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M4 5.5A2.5 2.5 0 016.5 3H12v17H6.5A2.5 2.5 0 004 22V5.5zM20 5.5A2.5 2.5 0 0017.5 3H12v17h5.5a2.5 2.5 0 012.5 2V5.5z"/></svg>
          <span>Find it in the University Library</span>
        </a>
        <p class="tb-header__note">
          Borrow a copy, check for an electronic edition, or request it through I-Share if
          every copy is out. The <a href={`${base}tools/`}>online tools</a> cite the chapter
          and equation numbers they implement, so you can work alongside the book.
        </p>
      </div>
    </header>

    <section class="tb-group">
      <div class="tb-group__label gsap-fade-up">
        <span>Chapters</span>
        <span class="tb-group__rule"></span>
      </div>
      <div class="tb-grid stagger-grid">
        {chapters.map(ch => (
          <a href={`${base}textbook/${ch.id}/`} class="tb-card gsap-stagger">
            <span class="tb-card__num">{ch.num}</span>
            <div class="tb-card__body">
              <h2 class="tb-card__title">{ch.title}</h2>
              <p class="tb-card__desc">{ch.desc}</p>
              {ch.relatedHws.length > 0 && (
                <div class="tb-card__hws">
                  {ch.relatedHws.map(h => <span class="tb-card__hw">{h.label}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="tb-group">
      <div class="tb-group__label gsap-fade-up">
        <span>Appendices</span>
        <span class="tb-group__rule"></span>
      </div>
      <div class="tb-grid stagger-grid">
        {appendices.map(ap => (
          <a href={`${base}textbook/${ap.id}/`} class="tb-card tb-card--appendix gsap-stagger">
            <span class="tb-card__num">{ap.num}</span>
            <div class="tb-card__body">
              <h2 class="tb-card__title">{ap.title}</h2>
              <p class="tb-card__desc">{ap.desc}</p>
              {ap.relatedHws.length > 0 && (
                <div class="tb-card__hws">
                  {ap.relatedHws.map(h => <span class="tb-card__hw">{h.label}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tb-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .tb-header {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .tb-header__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    margin-bottom: 0.625rem;
  }

  .tb-header h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-style: italic;
  }

  .tb-header__byline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 0.875rem;
  }

  .tb-header__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Where to actually get the book. This sits directly under the masthead
     because it is now the most useful thing on the page — it replaced twenty
     chapter downloads, and a student who came here for a PDF needs to land on
     the catalog link without hunting for it. */
  .tb-header__source {
    margin-top: 1.25rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 10px;
    background: var(--color-surface-alt);
  }

  .tb-header__cite {
    margin: 0 0 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .tb-header__cta {
    font-size: 0.8125rem;
    padding: 0.5rem 0.9rem;
  }

  .tb-header__note {
    margin: 0.875rem 0 0;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .tb-header__note a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tb-group { margin-bottom: 2.5rem; }

  .tb-group__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
  }

  .tb-group__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .tb-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
  }

  .tb-card {
    display: flex;
    gap: 1rem;
    /* Stretch every card to its row so a short description does not leave a
       ragged shelf of white space beneath it. */
    height: 100%;
    padding: 1.125rem 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* A hairline of accent along the top edge, drawn in from the left on hover.
     The chapter number already carries the color, so this only needs to
     confirm the hover rather than announce it. */
  .tb-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tb-card:hover::after { transform: scaleX(1); }

  .tb-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 26, 46, 0.08);
  }

  .tb-card:hover .tb-card__num {
    background: var(--color-accent);
    color: #fff;
    transform: scale(1.05);
  }

  .tb-card--appendix::after { background: var(--color-text-muted); }

  .tb-card--appendix:hover { border-color: var(--color-text-muted); }

  .tb-card--appendix:hover .tb-card__num {
    background: var(--color-text-muted);
    color: #fff;
  }

  :global([data-theme="dark"]) .tb-card {
    background: #162033;
    border-color: #2D3F59;
  }

  :global([data-theme="dark"]) .tb-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .tb-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: rgba(232, 119, 34, 0.09);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    flex-shrink: 0;
    align-self: flex-start;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .tb-card--appendix .tb-card__num {
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .tb-card--appendix .tb-card__num {
    background: #1B2D4A;
  }

  .tb-card__body { min-width: 0; }

  .tb-card__title {
    font-size: 0.9375rem;
    margin: 0.15rem 0 0.35rem;
    line-height: 1.35;
  }

  .tb-card__desc {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 0.55rem;
  }

  .tb-card__hws {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tb-card__hw {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }
</style>

<style>
  @media (prefers-reduced-motion: reduce) {
    .tb-card, .tb-card::after, .tb-card__num { transition: none; }
    .tb-card:hover { transform: none; }
    .tb-card:hover::after { transform: scaleX(1); }
    .tb-card:hover .tb-card__num { transform: none; }
  }
</style>
