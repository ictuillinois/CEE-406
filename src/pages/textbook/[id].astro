---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { textbook, chapters, appendices } from '../../data/textbook';

export function getStaticPaths() {
  return textbook.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;

const idx = textbook.findIndex(t => t.id === entry.id);
const prev = idx > 0 ? textbook[idx - 1] : null;
const next = idx < textbook.length - 1 ? textbook[idx + 1] : null;

const heading = entry.kind === 'chapter' ? `Chapter ${entry.num}` : `Appendix ${entry.num}`;
const pdfUrl = `${base}textbook/${entry.pdf}`;
---

<BaseLayout
  title={`${heading} — ${entry.title} · CEE 406 Textbook`}
  description={entry.desc}
>
  <div class="reader">
    <!-- Sidebar: chapter nav -->
    <aside class="reader-side" aria-label="Textbook contents">
      <a href={`${base}textbook/`} class="reader-side__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>All chapters</span>
      </a>

      <div class="reader-side__label">Chapters</div>
      <nav class="reader-side__nav">
        {chapters.map(ch => (
          <a href={`${base}textbook/${ch.id}/`} class:list={['reader-side__link', { active: ch.id === entry.id }]}>
            <span class="reader-side__num">{ch.num}</span>
            <span class="reader-side__title">{ch.title}</span>
          </a>
        ))}
      </nav>

      <div class="reader-side__label">Appendices</div>
      <nav class="reader-side__nav">
        {appendices.map(ap => (
          <a href={`${base}textbook/${ap.id}/`} class:list={['reader-side__link', { active: ap.id === entry.id }]}>
            <span class="reader-side__num">{ap.num}</span>
            <span class="reader-side__title">{ap.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main: PDF reader -->
    <div class="reader-main">
      <header class="reader-head">
        <div class="reader-head__text">
          <span class="reader-head__eyebrow">{heading} &middot; Huang, <em>Pavement Analysis and Design</em> (2004)</span>
          <h1 class="reader-head__title">{entry.title}</h1>
          <p class="reader-head__desc">{entry.desc}</p>
        </div>
        <div class="reader-head__actions">
          {entry.relatedHws.map(h => (
            <a href={`${base}homeworks/${h.id}/`} class="reader-hw">{h.label}</a>
          ))}
          <a href={pdfUrl} target="_blank" rel="noopener" class="btn btn-primary reader-dl">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            <span>Download PDF</span>
          </a>
        </div>
      </header>

      <div class="reader-frame-wrap">
        <iframe
          class="reader-frame"
          src={`${pdfUrl}#view=FitH`}
          title={`${heading} — ${entry.title}`}
          loading="lazy"
        ></iframe>
        <p class="reader-fallback">
          If the reader doesn't load, <a href={pdfUrl} target="_blank" rel="noopener">open the PDF directly</a>.
        </p>
      </div>

      <nav class="reader-nav" aria-label="Chapter navigation">
        {prev ? (
          <a href={`${base}textbook/${prev.id}/`} class="reader-nav__link">
            <span class="reader-nav__dir">&larr; Previous</span>
            <span class="reader-nav__label">{prev.kind === 'chapter' ? `Ch. ${prev.num}` : `App. ${prev.num}`} — {prev.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`${base}textbook/${next.id}/`} class="reader-nav__link reader-nav__link--next">
            <span class="reader-nav__dir">Next &rarr;</span>
            <span class="reader-nav__label">{next.kind === 'chapter' ? `Ch. ${next.num}` : `App. ${next.num}`} — {next.title}</span>
          </a>
        )}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .reader {
    display: grid;
    grid-template-columns: 1fr;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .reader {
      grid-template-columns: 15rem 1fr;
      padding: 2rem 2rem 5rem;
    }
  }

  /* ── Sidebar ── */
  .reader-side { display: none; }

  @media (min-width: 900px) {
    .reader-side {
      display: block;
      position: sticky;
      top: 4rem;
      max-height: calc(100vh - 4.5rem);
      overflow-y: auto;
      padding-right: 0.75rem;
    }
  }

  .reader-side__back {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .reader-side__back:hover {
    color: var(--color-accent);
    background: var(--color-surface-alt);
  }

  .reader-side__back svg { width: 0.875rem; height: 0.875rem; }

  .reader-side__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
    margin: 0.875rem 0 0.4rem;
  }

  .reader-side__nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .reader-side__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
    line-height: 1.35;
  }

  .reader-side__link:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
  }

  .reader-side__link.active {
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.06);
    font-weight: 600;
  }

  .reader-side__num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    min-width: 1.1rem;
    text-align: right;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Main ── */
  .reader-main { min-width: 0; }

  .reader-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .reader-head__text { max-width: 38rem; }

  .reader-head__eyebrow {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .reader-head__title {
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    margin: 0.35rem 0 0.5rem;
  }

  .reader-head__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .reader-head__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .reader-hw {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .reader-hw:hover { background: rgba(232, 119, 34, 0.15); }

  .reader-dl {
    font-size: 0.8125rem;
    padding: 0.5rem 0.9rem;
  }

  /* ── PDF frame ── */
  .reader-frame-wrap {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .reader-frame {
    display: block;
    width: 100%;
    height: min(78vh, 900px);
    border: none;
  }

  .reader-fallback {
    margin: 0;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
  }

  .reader-fallback a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Prev/next ── */
  .reader-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .reader-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: background 0.15s ease;
    max-width: 48%;
  }

  .reader-nav__link:hover { background: var(--color-surface-alt); }
  .reader-nav__link--next { text-align: right; margin-left: auto; }

  .reader-nav__dir {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .reader-nav__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
