---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { textbook, chapters, appendices } from '../../data/textbook';
import { TEXTBOOK_LIBRARY_URL, TEXTBOOK_CITATION, isHomeworkReleased } from '../../data/release';

export function getStaticPaths() {
  return textbook.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;

const idx = textbook.findIndex(t => t.id === entry.id);
const prev = idx > 0 ? textbook[idx - 1] : null;
const next = idx < textbook.length - 1 ? textbook[idx + 1] : null;

const heading = entry.kind === 'chapter' ? `Chapter ${entry.num}` : `Appendix ${entry.num}`;

// This page used to embed public/textbook/<entry.pdf> in an <iframe> and offer
// it for download. It no longer does, and the file no longer exists: Huang is a
// copyrighted commercial textbook and this repository is public. What survives
// is the part that was ours to publish — the citation, the course's own summary
// of the chapter, and the homeworks it backs — plus a route to a legitimate
// copy. See src/data/release.ts for the full reasoning.
---

<BaseLayout
  title={`${heading} — ${entry.title} · CEE 406 Textbook`}
  description={entry.desc}
>
  <div class="reader">
    <!-- Sidebar: chapter nav -->
    <aside class="reader-side" aria-label="Textbook contents">
      <a href={`${base}textbook/`} class="reader-side__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>All chapters</span>
      </a>

      <div class="reader-side__label">Chapters</div>
      <nav class="reader-side__nav">
        {chapters.map(ch => (
          <a href={`${base}textbook/${ch.id}/`} class:list={['reader-side__link', { active: ch.id === entry.id }]}>
            <span class="reader-side__num">{ch.num}</span>
            <span class="reader-side__title">{ch.title}</span>
          </a>
        ))}
      </nav>

      <div class="reader-side__label">Appendices</div>
      <nav class="reader-side__nav">
        {appendices.map(ap => (
          <a href={`${base}textbook/${ap.id}/`} class:list={['reader-side__link', { active: ap.id === entry.id }]}>
            <span class="reader-side__num">{ap.num}</span>
            <span class="reader-side__title">{ap.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main: PDF reader -->
    <div class="reader-main">
      <header class="reader-head">
        <div class="reader-head__text">
          <span class="reader-head__eyebrow">{heading} &middot; Huang, <em>Pavement Analysis and Design</em> (2004)</span>
          <h1 class="reader-head__title">{entry.title}</h1>
          <p class="reader-head__desc">{entry.desc}</p>
        </div>
        <div class="reader-head__actions">
          <a href={TEXTBOOK_LIBRARY_URL} target="_blank" rel="noopener" class="btn btn-primary reader-dl">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M4 5.5A2.5 2.5 0 016.5 3H12v17H6.5A2.5 2.5 0 004 22V5.5zM20 5.5A2.5 2.5 0 0017.5 3H12v17h5.5a2.5 2.5 0 012.5 2V5.5z"/></svg>
            <span>Find this book in the Library</span>
          </a>
        </div>
      </header>

      <section class="reader-source">
        <h2 class="reader-source__h">Reading this chapter</h2>
        <p class="reader-source__cite">{TEXTBOOK_CITATION}</p>
        <p class="reader-source__body">
          The course does not host the text. {heading} is part of a copyrighted
          commercial book, and redistributing it is not something this site can do.
          The University Library holds it — use the catalogue record below to borrow a
          physical copy, check for an electronic edition, or place a request through
          I-Share if every copy is out.
        </p>
        <p class="reader-source__actions">
          <a href={TEXTBOOK_LIBRARY_URL} target="_blank" rel="noopener" class="reader-source__link">
            University of Illinois Library catalogue &rarr;
          </a>
        </p>
        {entry.relatedHws.length > 0 && (
          <p class="reader-source__hws">
            <span class="reader-source__hws-label">Backs</span>
            {entry.relatedHws.map(h => (
              isHomeworkReleased(h.id)
                ? <a href={`${base}homeworks/${h.id}/`} class="reader-hw">{h.label}</a>
                : <span class="reader-hw reader-hw--locked" title="Not released yet">{h.label}</span>
            ))}
          </p>
        )}

        <p class="reader-source__note">
          Everything on this page other than the citation is course material and stays
          freely available. The <a href={`${base}tools/`}>online tools</a> implement the
          same equations, with the chapter and equation numbers cited on each one, so you
          can check your work against the book rather than substitute for it.
        </p>
      </section>

      <nav class="reader-nav" aria-label="Chapter navigation">
        {prev ? (
          <a href={`${base}textbook/${prev.id}/`} class="reader-nav__link">
            <span class="reader-nav__dir">&larr; Previous</span>
            <span class="reader-nav__label">{prev.kind === 'chapter' ? `Ch. ${prev.num}` : `App. ${prev.num}`} — {prev.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`${base}textbook/${next.id}/`} class="reader-nav__link reader-nav__link--next">
            <span class="reader-nav__dir">Next &rarr;</span>
            <span class="reader-nav__label">{next.kind === 'chapter' ? `Ch. ${next.num}` : `App. ${next.num}`} — {next.title}</span>
          </a>
        )}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .reader {
    display: grid;
    grid-template-columns: 1fr;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .reader {
      grid-template-columns: 15rem 1fr;
      padding: 2rem 2rem 5rem;
    }
  }

  /* ── Sidebar ── */
  .reader-side { display: none; }

  @media (min-width: 900px) {
    .reader-side {
      display: block;
      position: sticky;
      top: 4rem;
      max-height: calc(100vh - 4.5rem);
      overflow-y: auto;
      padding-right: 0.75rem;
    }
  }

  .reader-side__back {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .reader-side__back:hover {
    color: var(--color-accent);
    background: var(--color-surface-alt);
  }

  .reader-side__back svg { width: 0.875rem; height: 0.875rem; }

  .reader-side__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
    margin: 0.875rem 0 0.4rem;
  }

  .reader-side__nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .reader-side__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
    line-height: 1.35;
  }

  .reader-side__link:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
  }

  .reader-side__link.active {
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.06);
    font-weight: 600;
  }

  .reader-side__num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    min-width: 1.1rem;
    text-align: right;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Main ── */
  .reader-main { min-width: 0; }

  .reader-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .reader-head__text { max-width: 38rem; }

  .reader-head__eyebrow {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .reader-head__title {
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    margin: 0.35rem 0 0.5rem;
  }

  .reader-head__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .reader-head__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .reader-hw {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
    border: 1px solid rgba(232, 119, 34, 0.2);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .reader-hw:hover { background: rgba(232, 119, 34, 0.15); }

  /* A homework this chapter backs, that has not been released yet. It still
     earns a chip — knowing the chapter matters later is useful — but it must
     not look clickable, because its page does not exist. */
  .reader-hw--locked {
    color: var(--color-text-muted);
    background: transparent;
    border-color: var(--color-border);
    border-style: dashed;
    cursor: default;
  }
  .reader-hw--locked:hover { background: transparent; }

  .reader-dl {
    font-size: 0.8125rem;
    padding: 0.5rem 0.9rem;
  }

  /* ── Where to get the book ──────────────────────────────────────────────
     This block replaces the PDF iframe. It is deliberately a calm, ordinary
     content card and not a warning banner: a student arriving here has done
     nothing wrong, and the useful information is the catalogue link, not an
     apology. */
  .reader-source {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 10px;
    background: var(--color-surface-alt);
    padding: 1.25rem 1.5rem;
  }

  .reader-source__h {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .reader-source__cite {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .reader-source__body {
    margin: 0 0 0.875rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .reader-source__actions { margin: 0 0 0.875rem; }

  .reader-source__link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reader-source__hws {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.875rem;
  }

  .reader-source__hws-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-right: 0.1rem;
  }

  .reader-source__note {
    margin: 0;
    padding-top: 0.875rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .reader-source__note a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Prev/next ── */
  .reader-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .reader-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: background 0.15s ease;
    max-width: 48%;
  }

  .reader-nav__link:hover { background: var(--color-surface-alt); }
  .reader-nav__link--next { text-align: right; margin-left: auto; }

  .reader-nav__dir {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .reader-nav__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
