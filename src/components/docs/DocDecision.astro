---
interface Choice { value: string; label: string; title: string; body: string; href: string; linkLabel: string; }
interface Props { id: string; label: string; choices: Choice[]; }
const { id, label, choices } = Astro.props;
---
<div class="doc-decision" data-decision>
  <label for={id} hidden>{label}
    <select id={id}>
      {choices.map(choice => <option value={choice.value}>{choice.label}</option>)}
    </select>
  </label>
  <div aria-live="polite" aria-atomic="true">
    {choices.map(choice => <div data-choice={choice.value}>
      <h3>{choice.title}</h3>
      <p>{choice.body}</p>
      <p><a href={choice.href}>{choice.linkLabel}</a></p>
    </div>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-decision]').forEach(widget => {
    const select = widget.querySelector('select');
    if (!select) return;
    const update = () => widget.querySelectorAll<HTMLElement>('[data-choice]').forEach(panel => {
      panel.hidden = panel.dataset.choice !== select.value;
    });
    widget.querySelector('label')!.hidden = false;
    select.addEventListener('change', update);
    update();
  });
</script>
<style>
  .doc-decision { border: 1px solid var(--color-border); border-radius: 8px; padding: 1rem; margin: 1rem 0; }
  label { font-size: .875rem; font-weight: 500; }
  label:not([hidden]) { display: grid; gap: .5rem; }
  select { width: 100%; font: inherit; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 5px; padding: .6rem; }
  select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  h3 { font-size: .9375rem; margin: 1rem 0 .5rem; }
  p { font-size: .875rem; margin-bottom: .5rem; }
</style>
