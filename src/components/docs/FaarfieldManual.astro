---
import topics from '../../data/faarfield-reference.json';
const base = import.meta.env.BASE_URL;
const groups = [...new Set(topics.map(topic => topic.group))];
const groupLabel = (label: string) => label.replace(/^APPENDIX ([A-E]): /, 'Appendix $1: ');
---
<div class="manual-topics" data-manual-topics>
  <div class="manual-filters" hidden>
    <label>Find a topic<input type="search" id="topic-filter" placeholder="Traffic, CBR, overlays…" autocomplete="off" /></label>
    <label>Chapter<select id="topic-group"><option value="">All chapters</option>{groups.map(group => <option value={group}>{groupLabel(group)}</option>)}</select></label>
    <button type="button" class="manual-reset">Clear</button>
  </div>
  <p id="topic-count" role="status" aria-live="polite">{topics.length} topics</p>
  {groups.map((group, i) => <details class="manual-group" data-manual-group={group} open={i === 0}>
    <summary><span>{groupLabel(group)}</span><span class="manual-group-count">{topics.filter(topic => topic.group === group).length}</span></summary>
    <ul>
      {topics.filter(topic => topic.group === group).map(topic => <li data-topic={`${topic.title} ${topic.group} ${topic.html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ')}`.toLowerCase()}>
        <a href={`${base}documentation/faarfield/reference/${topic.id}/`}>{topic.title}<span aria-hidden="true">→</span></a>
      </li>)}
    </ul>
  </details>)}
  <p class="manual-empty" hidden>No matching topics. Try a shorter term or choose another chapter.</p>
</div>
<script>
  const widget = document.querySelector<HTMLElement>('[data-manual-topics]');
  if (widget) {
    const search = widget.querySelector<HTMLInputElement>('#topic-filter')!;
    const chapter = widget.querySelector<HTMLSelectElement>('#topic-group')!;
    const groups = [...widget.querySelectorAll<HTMLDetailsElement>('[data-manual-group]')];
    const normalOpen = groups.map(group => group.open);
    const url = new URL(window.location.href);
    search.value = url.searchParams.get('topic') || '';
    chapter.value = url.searchParams.get('chapter') || '';
    widget.querySelector<HTMLElement>('.manual-filters')!.hidden = false;
    function filter(updateUrl = true) {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const filtering = terms.length > 0 || chapter.value !== '';
      let count = 0;
      groups.forEach((group, index) => {
        let matches = 0;
        group.querySelectorAll<HTMLElement>('[data-topic]').forEach(item => {
          const text = item.dataset.topic || '';
          const show = (!chapter.value || chapter.value === group.dataset.manualGroup) && terms.every(term => text.includes(term));
          item.hidden = !show;
          if (show) matches++;
        });
        group.hidden = matches === 0;
        group.open = filtering ? matches > 0 : normalOpen[index];
        group.querySelector<HTMLElement>('.manual-group-count')!.textContent = String(matches);
        count += matches;
      });
      widget!.querySelector<HTMLElement>('#topic-count')!.textContent = count ? `${count} ${count === 1 ? 'topic' : 'topics'}` : 'No matching topics.';
      widget!.querySelector<HTMLElement>('.manual-empty')!.hidden = count > 0;
      if (updateUrl) {
        const next = new URL(window.location.href);
        for (const [key, value] of [['topic', search.value.trim()], ['chapter', chapter.value]]) {
          if (value) next.searchParams.set(key, value); else next.searchParams.delete(key);
        }
        history.replaceState(null, '', next);
      }
    }
    search.addEventListener('input', () => filter());
    chapter.addEventListener('change', () => filter());
    widget.querySelector('.manual-reset')!.addEventListener('click', () => {
      search.value = ''; chapter.value = ''; filter(); search.focus();
    });
    filter(false);
  }
</script>
<style>
  .manual-topics { margin: 1.5rem 0; }
  .manual-filters:not([hidden]) { display: grid; grid-template-columns: 1fr 1fr auto; gap: .75rem; align-items: end; }
  label { display: grid; gap: .4rem; min-width: 0; font-size: .8125rem; font-weight: 500; }
  input, select, button { font: inherit; min-width: 0; padding: .6rem .75rem; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-surface); color: var(--color-text); }
  select { width: 100%; }
  button { cursor: pointer; font-size: .8125rem; }
  input:focus-visible, select:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  #topic-count { margin: .75rem 0; font-size: .75rem; color: var(--color-text-muted); }
  .manual-group { border: 1px solid var(--color-border); border-radius: 8px; margin: .5rem 0; overflow: clip; }
  summary { display: flex; gap: .75rem; align-items: center; padding: .85rem 1rem; font-size: .875rem; font-weight: 500; cursor: pointer; background: var(--color-surface-alt); }
  summary::before { content: '+'; color: var(--color-accent); font-family: var(--font-mono); }
  details[open] summary::before { content: '−'; }
  .manual-group-count { margin-left: auto; font-family: var(--font-mono); font-size: .6875rem; color: var(--color-text-muted); }
  ul { list-style: none; padding: .35rem 1rem; margin: 0; }
  li + li { border-top: 1px solid var(--color-border); }
  a { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .7rem 0; font-size: .8125rem; text-decoration: none; }
  a span { color: var(--color-text-muted); }
  .manual-empty { color: var(--color-text-muted); }
  @media (max-width: 600px) { .manual-filters:not([hidden]) { grid-template-columns: 1fr; } .manual-reset { justify-self: start; } }
</style>
