---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navItems = [
  // Order matters and is deliberate: the tools are what this site can offer a
  // student today, so they come first. Homeworks and the textbook follow the
  // order of the landing page, which uses the same sequence.
  { label: 'Home', href: base },
  { label: 'Tools', href: `${base}tools/` },
  { label: 'Homeworks', href: `${base}homeworks/` },
  { label: 'Textbook', href: `${base}textbook/` },
];

function isActive(href: string) {
  if (href === base) return currentPath === base || currentPath === base.slice(0, -1);
  return currentPath.startsWith(href);
}
---

<nav class="nav" id="main-nav" aria-label="Main navigation">
  <div class="container nav-inner">
    <a href={base} class="nav-brand">
      <img src={`${base}favicon.png`} alt="Illinois Block I" class="nav-logo" width="26" height="26" />
      <div class="nav-brand-text">
        <span class="nav-brand-name">CEE 406 · Pavement Design I</span>
        <span class="nav-brand-org">University of Illinois Urbana-Champaign</span>
      </div>
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-right">
      <ul class="nav-links" id="nav-links" role="list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              {...(isActive(item.href) ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <button class="nav-search" id="nav-search" aria-label="Search" title="Search (Ctrl+K)">
        <svg class="nav-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <kbd class="nav-search__kbd">⌘K</kbd>
      </button>
      <div class="nav-sep" aria-hidden="true"></div>
      <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    links?.classList.toggle('open');
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(15, 26, 46, 0.92);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }

  /* ── Brand ── */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-brand:hover .nav-brand-name {
    color: #fff;
  }

  .nav-brand:hover .nav-brand-org {
    color: rgba(255, 255, 255, 0.45);
  }

  .nav-logo {
    border-radius: 3px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .nav-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .nav-brand-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.88);
    letter-spacing: -0.005em;
    transition: color 0.2s ease;
  }

  .nav-brand-org {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  /* ── Right ── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-sep {
    width: 1px;
    height: 1rem;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 0.5rem;
  }

  /* ── Links ── */
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 7px;
    padding: 3px;
  }

  .nav-link {
    display: block;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.50);
    border-radius: 5px;
    transition: color 0.15s ease, background 0.15s ease;
    position: relative;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-link:active {
    background: rgba(255, 255, 255, 0.12);
  }

  .nav-link:focus-visible {
    outline: 1.5px solid var(--color-accent);
    outline-offset: -1.5px;
  }

  .nav-link.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    font-weight: 600;
  }

  /* ── Search button ── */
  .nav-search {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.625rem;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.375rem;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.7);
    transition: all var(--transition);
    flex-shrink: 0;
  }

  .nav-search:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(232, 119, 34, 0.08);
  }

  .nav-search:focus-visible {
    outline: 1.5px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-search__icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .nav-search__kbd {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    padding: 0.0625rem 0.3rem;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .nav-search__kbd { display: none; }
    .nav-search { padding: 0 0.5rem; }
  }

  /* ── Hamburger ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.10);
    cursor: pointer;
    padding: 5px;
    border-radius: 5px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .nav-toggle:focus-visible {
    outline: 1.5px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-toggle span {
    display: block;
    width: 15px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 1px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-brand-org { display: none; }
  }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(15, 26, 46, 0.97);
      backdrop-filter: blur(24px);
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 0;
      padding: 0.375rem 1.25rem 0.625rem;
      display: none;
      gap: 1px;
    }

    .nav-links.open { display: flex; }

    .nav-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.84rem;
      border-radius: 6px;
    }

    .nav-link.active {
      color: var(--color-accent);
    }

    .nav-sep { display: none; }
    .nav-brand-name { font-size: 0.78rem; }
  }
</style>
