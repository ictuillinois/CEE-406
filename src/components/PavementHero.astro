---
// Signature hero: animated pavement cross-section with a rolling wheel load,
// a live deflection basin, and Boussinesq-style pressure bulbs diffusing
// through the layers. Static single frame under prefers-reduced-motion.
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-label="Course introduction">
  <canvas class="hero-canvas" id="pavement-canvas" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="hero-eyebrow gsap-fade-up">
      <img src={`${base}favicon.png`} alt="" width="16" height="16" />
      <span>CEE 406 &middot; University of Illinois Urbana-Champaign</span>
    </p>
    <h1 class="hero-title gsap-fade-up">Pavement Design&nbsp;I</h1>
    <p class="hero-sub gsap-fade-up">
      From wheel load to layer thickness. Work each homework with its online tools,
      read the textbook chapter behind it, and follow the stress path all the way
      down to the subgrade.
    </p>
    <div class="hero-actions gsap-fade-up">
      <a href={`${base}homeworks/`} class="btn btn-primary">Browse homeworks</a>
      <a href={`${base}textbook/`} class="btn btn-outline">Open the textbook</a>
    </div>
    <dl class="hero-stats gsap-fade-up">
      <div class="hero-stat">
        <dt>Homeworks</dt>
        <dd>10</dd>
      </div>
      <div class="hero-stat">
        <dt>Textbook chapters</dt>
        <dd>13 + 7</dd>
      </div>
      <div class="hero-stat">
        <dt>Online tools</dt>
        <dd>2 live</dd>
      </div>
      <div class="hero-stat">
        <dt>Instructor</dt>
        <dd>Prof. Al-Qadi</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  function initPavementCanvas() {
    const canvas = document.getElementById('pavement-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, dpr = 1;
    let rafId = 0;
    let visible = true;
    let last = 0;
    let travel = 0; // wheel travel distance, px

    // Pre-generated texture particles
    let asphaltGrains: { x: number; y: number; r: number; a: number }[] = [];
    let stones: { x: number; y: number; r: number; rot: number; sides: number; tone: number }[] = [];
    let subbaseGrains: { x: number; y: number; r: number; a: number }[] = [];
    let subgradeDots: { x: number; y: number; r: number; a: number }[] = [];

    // ── Layer geometry: road section anchored to the hero bottom ──
    const roadDepth = () => Math.min(H * 0.42, 360);
    const surfY = () => H - roadDepth();
    const acBot = () => surfY() + roadDepth() * 0.21;
    const baseBot = () => surfY() + roadDepth() * 0.48;
    const subbaseBot = () => surfY() + roadDepth() * 0.72;

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      makeTextures();
    }

    function makeTextures() {
      const sy = surfY();
      asphaltGrains = [];
      for (let i = 0; i < W / 3; i++) {
        asphaltGrains.push({
          x: Math.random() * W,
          y: sy + 2 + Math.random() * (acBot() - sy - 4),
          r: 0.4 + Math.random() * 1.1,
          a: 0.04 + Math.random() * 0.14,
        });
      }
      stones = [];
      for (let i = 0; i < W / 9; i++) {
        stones.push({
          x: Math.random() * W,
          y: acBot() + 5 + Math.random() * (baseBot() - acBot() - 10),
          r: 2.2 + Math.random() * 3.4,
          rot: Math.random() * Math.PI,
          sides: 5 + Math.floor(Math.random() * 3),
          tone: Math.random(),
        });
      }
      subbaseGrains = [];
      for (let i = 0; i < W / 5; i++) {
        subbaseGrains.push({
          x: Math.random() * W,
          y: baseBot() + 3 + Math.random() * (subbaseBot() - baseBot() - 6),
          r: 0.7 + Math.random() * 1.6,
          a: 0.08 + Math.random() * 0.15,
        });
      }
      subgradeDots = [];
      for (let i = 0; i < W / 14; i++) {
        subgradeDots.push({
          x: Math.random() * W,
          y: subbaseBot() + 4 + Math.random() * (H - subbaseBot() - 8),
          r: 0.6 + Math.random() * 1.3,
          a: 0.05 + Math.random() * 0.1,
        });
      }
    }

    const dark = () => document.documentElement.getAttribute('data-theme') === 'dark';

    /** Deflection basin: exaggerated surface dip centered on the wheel. */
    function basin(x: number, wx: number, amp: number, width: number): number {
      const u = (x - wx) / width;
      return amp * Math.exp(-u * u);
    }

    function drawPolygon(x: number, y: number, r: number, rot: number, sides: number) {
      ctx!.beginPath();
      for (let i = 0; i <= sides; i++) {
        const ang = rot + (i * Math.PI * 2) / sides;
        const rr = r * (0.8 + 0.2 * Math.sin(i * 2.7 + rot * 5));
        const px = x + Math.cos(ang) * rr;
        const py = y + Math.sin(ang) * rr * 0.8;
        i === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
      }
      ctx!.closePath();
    }

    function drawScene() {
      const isDark = dark();
      ctx!.clearRect(0, 0, W, H);

      const sy = surfY();
      const R = Math.max(26, Math.min(46, H * 0.055)); // wheel radius
      const span = W + 6 * R;
      const wx = reduced ? W * 0.64 : (travel % span) - 3 * R;
      const AMP = 5;                 // basin amplitude, px
      const BW = R * 2.4;            // basin half-width parameter
      const wy = sy + basin(wx, wx, AMP, BW) - R + 1.5;

      // ── Layers (drawn with the deflected surface) ──
      const surfAt = (x: number) => sy + basin(x, wx, AMP, BW);

      // Asphalt concrete band
      ctx!.beginPath();
      ctx!.moveTo(0, acBot());
      ctx!.lineTo(0, surfAt(0));
      const step = Math.max(6, W / 220);
      for (let x = 0; x <= W + step; x += step) ctx!.lineTo(x, surfAt(x));
      ctx!.lineTo(W, acBot());
      ctx!.closePath();
      ctx!.fillStyle = isDark ? '#171c26' : '#20242e';
      ctx!.fill();

      // Aggregate base
      ctx!.fillStyle = isDark ? '#4d4130' : '#8a7452';
      ctx!.fillRect(0, acBot(), W, baseBot() - acBot());
      // Subbase
      ctx!.fillStyle = isDark ? '#3c3527' : '#a8946e';
      ctx!.fillRect(0, baseBot(), W, subbaseBot() - baseBot());
      // Subgrade fades into the page background
      const sg = ctx!.createLinearGradient(0, subbaseBot(), 0, H);
      if (isDark) {
        sg.addColorStop(0, '#2b2620');
        sg.addColorStop(1, '#10141d');
      } else {
        sg.addColorStop(0, '#6e5c42');
        sg.addColorStop(1, '#3f3527');
      }
      ctx!.fillStyle = sg;
      ctx!.fillRect(0, subbaseBot(), W, H - subbaseBot());

      // ── Textures ──
      for (const g of asphaltGrains) {
        ctx!.beginPath();
        ctx!.arc(g.x, g.y + basin(g.x, wx, AMP * 0.8, BW), g.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255,255,255,${g.a * 0.5})`;
        ctx!.fill();
      }
      for (const s of stones) {
        drawPolygon(s.x, s.y, s.r, s.rot, s.sides);
        const t = 22 + s.tone * 26;
        ctx!.fillStyle = isDark ? `rgba(${t + 30},${t + 22},${t + 8},0.55)` : `rgba(${t + 8},${t - 2},${t - 14},0.35)`;
        ctx!.fill();
      }
      for (const g of subbaseGrains) {
        ctx!.beginPath();
        ctx!.arc(g.x, g.y, g.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(38,31,20,${g.a})`;
        ctx!.fill();
      }
      for (const g of subgradeDots) {
        ctx!.beginPath();
        ctx!.arc(g.x, g.y, g.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(0,0,0,${g.a + 0.05})`;
        ctx!.fill();
      }

      // Layer interfaces
      ctx!.strokeStyle = 'rgba(0,0,0,0.28)';
      ctx!.lineWidth = 1;
      for (const y of [acBot(), baseBot(), subbaseBot()]) {
        ctx!.beginPath();
        ctx!.moveTo(0, y);
        ctx!.lineTo(W, y);
        ctx!.stroke();
      }

      // ── Deflected surface line ──
      ctx!.beginPath();
      ctx!.moveTo(0, surfAt(0));
      for (let x = 0; x <= W + step; x += step) ctx!.lineTo(x, surfAt(x));
      ctx!.strokeStyle = 'rgba(255,255,255,0.4)';
      ctx!.lineWidth = 1.5;
      ctx!.stroke();

      // Undeflected reference (dashed) inside the basin region
      ctx!.setLineDash([3, 4]);
      ctx!.beginPath();
      ctx!.moveTo(wx - BW * 2.2, sy);
      ctx!.lineTo(wx + BW * 2.2, sy);
      ctx!.strokeStyle = 'rgba(255,255,255,0.18)';
      ctx!.lineWidth = 1;
      ctx!.stroke();
      ctx!.setLineDash([]);

      // ── Pressure bulbs (Boussinesq isobars) under the contact ──
      const t = travel / 60; // slow phase driver
      const a = R * 0.62;
      const cy = surfAt(wx) + 1;
      const bulbs = [
        { k: 0.55, alpha: 0.6, label: '0.9p' },
        { k: 1.15, alpha: 0.44, label: '0.7p' },
        { k: 1.9, alpha: 0.32, label: '0.5p' },
        { k: 2.9, alpha: 0.22, label: '0.3p' },
        { k: 4.3, alpha: 0.13, label: '0.1p' },
      ];

      const glow = ctx!.createRadialGradient(wx, cy, 0, wx, cy, a * 6.5);
      glow.addColorStop(0, 'rgba(232,119,34,0.30)');
      glow.addColorStop(1, 'rgba(232,119,34,0)');
      ctx!.fillStyle = glow;
      ctx!.fillRect(wx - a * 7, cy, a * 14, a * 7);

      ctx!.lineWidth = 1.25;
      bulbs.forEach((b, i) => {
        const pulse = reduced ? 1 : 0.94 + 0.06 * Math.sin(t * 2.0 - i * 0.7);
        const ry = a * b.k * pulse;
        const rx = a * (1 + b.k * 0.78) * pulse;
        ctx!.beginPath();
        ctx!.ellipse(wx, cy, rx, ry, 0, 0, Math.PI);
        ctx!.strokeStyle = `rgba(232,119,34,${b.alpha})`;
        ctx!.stroke();
      });
      if (wx > W * 0.12 && wx < W * 0.86) {
        ctx!.font = '500 9px "IBM Plex Mono", monospace';
        ctx!.fillStyle = 'rgba(245,155,75,0.8)';
        ctx!.textAlign = 'left';
        for (const i of [1, 3]) {
          const b = bulbs[i];
          const ry = a * b.k;
          const rx = a * (1 + b.k * 0.78);
          ctx!.fillText(b.label, wx + rx * 0.74, cy + ry * 0.76);
        }
      }

      // ── Contact patch highlight ──
      ctx!.beginPath();
      ctx!.rect(wx - a, cy - 1.5, a * 2, 3);
      ctx!.fillStyle = 'rgba(232,119,34,0.75)';
      ctx!.fill();

      // ── Wheel ──
      const rot = travel / R;
      // Tire
      ctx!.beginPath();
      ctx!.arc(wx, wy, R, 0, Math.PI * 2);
      ctx!.fillStyle = isDark ? '#0c0f16' : '#14161c';
      ctx!.fill();
      ctx!.lineWidth = 2;
      ctx!.strokeStyle = 'rgba(255,255,255,0.15)';
      ctx!.stroke();
      // Tread notches
      ctx!.strokeStyle = 'rgba(255,255,255,0.20)';
      ctx!.lineWidth = 1.5;
      for (let i = 0; i < 12; i++) {
        const ang = rot + (i * Math.PI * 2) / 12;
        ctx!.beginPath();
        ctx!.moveTo(wx + Math.cos(ang) * (R - 4), wy + Math.sin(ang) * (R - 4));
        ctx!.lineTo(wx + Math.cos(ang) * R, wy + Math.sin(ang) * R);
        ctx!.stroke();
      }
      // Rim
      ctx!.beginPath();
      ctx!.arc(wx, wy, R * 0.52, 0, Math.PI * 2);
      ctx!.fillStyle = isDark ? '#232a38' : '#2d3442';
      ctx!.fill();
      ctx!.strokeStyle = 'rgba(255,255,255,0.24)';
      ctx!.lineWidth = 1.5;
      ctx!.stroke();
      // Spokes
      ctx!.strokeStyle = 'rgba(255,255,255,0.26)';
      for (let i = 0; i < 5; i++) {
        const ang = rot + (i * Math.PI * 2) / 5;
        ctx!.beginPath();
        ctx!.moveTo(wx, wy);
        ctx!.lineTo(wx + Math.cos(ang) * R * 0.44, wy + Math.sin(ang) * R * 0.44);
        ctx!.stroke();
      }
      // Hub
      ctx!.beginPath();
      ctx!.arc(wx, wy, R * 0.1, 0, Math.PI * 2);
      ctx!.fillStyle = '#E87722';
      ctx!.fill();

      // ── Load arrow ──
      ctx!.strokeStyle = 'rgba(232,119,34,0.9)';
      ctx!.fillStyle = 'rgba(232,119,34,0.9)';
      ctx!.lineWidth = 2;
      const ay0 = wy - R - 36, ay1 = wy - R - 10;
      ctx!.beginPath();
      ctx!.moveTo(wx, ay0);
      ctx!.lineTo(wx, ay1);
      ctx!.stroke();
      ctx!.beginPath();
      ctx!.moveTo(wx, ay1 + 5);
      ctx!.lineTo(wx - 5, ay1 - 4);
      ctx!.lineTo(wx + 5, ay1 - 4);
      ctx!.closePath();
      ctx!.fill();
      ctx!.font = '500 10px "IBM Plex Mono", monospace';
      ctx!.textAlign = 'center';
      ctx!.fillText('P', wx + 11, ay0 + 9);

      // ── Depth ruler (z/a) on the right ──
      const rx0 = W - 54;
      ctx!.strokeStyle = 'rgba(255,255,255,0.22)';
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      ctx!.moveTo(rx0, sy);
      ctx!.lineTo(rx0, Math.min(sy + 4 * a * 1.6, H - 12));
      ctx!.stroke();
      ctx!.font = '500 8.5px "IBM Plex Mono", monospace';
      ctx!.textAlign = 'left';
      ctx!.fillStyle = 'rgba(255,255,255,0.35)';
      for (let i = 0; i <= 4; i++) {
        const zy = sy + i * a * 1.6;
        if (zy > H - 12) break;
        ctx!.beginPath();
        ctx!.moveTo(rx0 - 3, zy);
        ctx!.lineTo(rx0 + 3, zy);
        ctx!.stroke();
        ctx!.fillText(i === 0 ? 'z=0' : `${i}a`, rx0 + 7, zy + 3);
      }

      // ── Layer labels ──
      ctx!.font = '600 9.5px "IBM Plex Mono", monospace';
      ctx!.textAlign = 'left';
      const labels: [string, number][] = [
        ['ASPHALT CONCRETE', (sy + acBot()) / 2],
        ['AGGREGATE BASE', (acBot() + baseBot()) / 2],
        ['SUBBASE', (baseBot() + subbaseBot()) / 2],
        ['SUBGRADE', subbaseBot() + (H - subbaseBot()) * 0.4],
      ];
      labels.forEach(([text, y], i) => {
        ctx!.fillStyle = isDark
          ? 'rgba(255,255,255,0.38)'
          : i === 0 ? 'rgba(255,255,255,0.5)' : i === 3 ? 'rgba(255,255,255,0.4)' : 'rgba(20,14,6,0.6)';
        ctx!.fillText(text, 16, y + 3.5);
      });
    }

    function loop(ms: number) {
      if (!last) last = ms;
      const dt = Math.min(50, ms - last);
      last = ms;
      if (visible) {
        travel += (dt / 1000) * (W / 15); // ~15 s to cross
        drawScene();
      }
      if (!reduced) rafId = requestAnimationFrame(loop);
    }

    resize();
    drawScene();

    window.addEventListener('resize', () => {
      resize();
      drawScene();
    });

    if (!reduced) {
      const io = new IntersectionObserver(entries => {
        visible = entries[0]?.isIntersecting ?? true;
      });
      io.observe(canvas);
      rafId = requestAnimationFrame(loop);
      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(rafId);
        io.disconnect();
      }, { once: true });
    }
  }

  initPavementCanvas();
  document.addEventListener('astro:after-swap', initPavementCanvas);
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: flex-start;
    background:
      radial-gradient(120% 90% at 85% 0%, #16294a 0%, rgba(19, 34, 60, 0) 55%),
      linear-gradient(180deg, #0F1A2E 0%, #13223C 60%, #0F1A2E 100%);
    overflow: hidden;
    margin-top: -3.25rem; /* pull under fixed nav */
    padding-top: 3.25rem;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: hero-canvas-in 1.2s ease both;
  }

  @keyframes hero-canvas-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas { animation: none; }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(15, 26, 46, 0.88) 0%, rgba(15, 26, 46, 0.55) 45%, rgba(15, 26, 46, 0.08) 75%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: clamp(3.5rem, 9vh, 6.5rem);
    padding-bottom: clamp(3rem, 30vh, 20rem);
    max-width: var(--max-width);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    padding: 0.3rem 0.8rem 0.3rem 0.5rem;
    margin: 0 0 1.25rem;
  }

  .hero-title {
    color: #fff;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    margin: 0 0 1rem;
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.62);
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    line-height: 1.65;
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* ── Stats: HUD chip that can safely overlap the road section ── */
  .hero-stats {
    display: inline-flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0.875rem 1.375rem;
    background: rgba(11, 18, 32, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-stat dt {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 0.15rem;
  }

  .hero-stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 640px) {
    .hero-content {
      padding-bottom: clamp(13rem, 44vh, 19rem);
    }
    .hero-stats { gap: 1.1rem 1.5rem; padding: 0.75rem 1rem; }
  }
</style>
