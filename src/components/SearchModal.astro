---
import { tools } from '../data/tools';
import { isToolReleased } from '../data/release';

const base = import.meta.env.BASE_URL;

// These shortcuts are hardcoded and appear on EVERY page, so they are the one
// place a link can outlive the thing it points at without any index noticing.
// This list used to name stress-explorer and esal-calculator; both are locked
// now, and both returned 404 on all 26 pages. Naming a tool here now goes
// through the catalogue and the release gate, so it cannot happen again.
const shortcut = (slug: string, icon: string, desc: string) => {
  const t = tools.find(x => x.slug === slug);
  if (!t || !isToolReleased(slug)) return null;
  return { icon, label: t.name, desc, href: `${base}tools/${slug}/` };
};

// Same order as the nav and the landing page: tools first.
const quickLinks = [
  { icon: '🧰', label: 'Online Tools', desc: 'Interactive calculators and 3-D studios for the homeworks', href: `${base}tools/` },
  shortcut('gear3d', '🚛', 'Axle and landing-gear configurations, true to scale in 3-D'),
  shortcut('cross-section-studio', '📐', 'Publication-quality 3-D pavement cross sections'),
  { icon: '📝', label: 'Homeworks', desc: 'The assignment sequence, released week by week', href: `${base}homeworks/` },
  { icon: '📖', label: 'Textbook', desc: 'Reading map and where to borrow the book', href: `${base}textbook/` },
].filter(Boolean);
---

<div class="search-overlay" id="search-overlay" aria-hidden="true">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Search site">
    <!-- Input -->
    <div class="search-input-wrap">
      <svg class="search-input-icon" id="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" class="search-input" id="search-input" placeholder="Search homeworks, textbook, tools..." autocomplete="off" spellcheck="false" />
      <span class="search-count" id="search-count"></span>
      <button class="search-clear" id="search-clear" aria-label="Clear search" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <kbd class="search-esc">ESC</kbd>
    </div>

    <!-- Results -->
    <div class="search-results" id="search-results">
      <!-- Quick links (visible when empty) -->
      <div class="search-quick" id="search-quick">
        <div class="search-quick__label">Quick navigation</div>
        {quickLinks.map(link => (
          <a href={link.href} class="search-quick__link">
            <span class="search-quick__icon">{link.icon}</span>
            <div class="search-quick__body">
              <span class="search-quick__name">{link.label}</span>
              <span class="search-quick__desc">{link.desc}</span>
            </div>
            <svg class="search-quick__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
      <!-- Skeleton (shown while searching) -->
      <div class="search-skeleton" id="search-skeleton" style="display:none;">
        <div class="search-skeleton__item"><div class="search-skeleton__bar search-skeleton__bar--short"></div><div class="search-skeleton__bar"></div></div>
        <div class="search-skeleton__item"><div class="search-skeleton__bar search-skeleton__bar--short"></div><div class="search-skeleton__bar"></div></div>
        <div class="search-skeleton__item"><div class="search-skeleton__bar search-skeleton__bar--short"></div><div class="search-skeleton__bar"></div></div>
      </div>
      <!-- No results -->
      <div class="search-no-results" id="search-no-results" style="display:none;">
        <svg class="search-no-results__icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <circle cx="22" cy="22" r="14" stroke="currentColor" stroke-width="2" opacity="0.2"/><line x1="32" y1="32" x2="42" y2="42" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.2"/>
        </svg>
        <span class="search-no-results__text" id="search-no-results-text">No results found</span>
        <span class="search-no-results__hint">Try different keywords or browse the homeworks</span>
        <a href={`${base}homeworks/`} class="search-no-results__action">Browse Homeworks &rarr;</a>
      </div>
    </div>

    <!-- Footer -->
    <div class="search-footer">
      <div class="search-footer__hints">
        <span class="search-hint"><kbd>&uarr;</kbd><kbd>&darr;</kbd> Navigate</span>
        <span class="search-hint"><kbd>&crarr;</kbd> Open</span>
        <span class="search-hint"><kbd>esc</kbd> Close</span>
      </div>
      <span class="search-footer__powered">Powered by Pagefind</span>
    </div>
  </div>
</div>

<script data-search-base={base} is:inline>
(function() {
  var pagefind = null, pagefindLoading = false, debounceTimer = null, activeIndex = -1, resultUrls = [];
  var scriptTag = document.querySelector('script[data-search-base]');
  var searchBase = scriptTag ? scriptTag.getAttribute('data-search-base') : '/';

  async function loadPagefind() {
    if (pagefind) return pagefind;
    if (pagefindLoading) return null;
    pagefindLoading = true;
    try { pagefind = await import(searchBase + 'pagefind/pagefind.js'); await pagefind.init(); return pagefind; }
    catch (e) { pagefindLoading = false; return null; }
  }

  function getEls() {
    return { overlay: document.getElementById('search-overlay'), backdrop: document.getElementById('search-backdrop'), input: document.getElementById('search-input'), results: document.getElementById('search-results'), quick: document.getElementById('search-quick'), skeleton: document.getElementById('search-skeleton'), noResults: document.getElementById('search-no-results'), noResultsText: document.getElementById('search-no-results-text'), count: document.getElementById('search-count'), clear: document.getElementById('search-clear'), icon: document.getElementById('search-icon') };
  }

  function breadcrumbFromUrl(url) {
    var p = url.replace(searchBase, '').replace(/^\/|\/$/g, '').replace(/\/index\.html$/, '');
    if (!p) return '';
    return p.split('/').map(function(s) { return s.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }); }).join(' \u203A ');
  }

  function sectionFromUrl(url) {
    if (url.indexOf('/homeworks/') > -1) return 'Homeworks';
    if (url.indexOf('/textbook/') > -1) return 'Textbook';
    if (url.indexOf('/tools/') > -1) return 'Tools';
    return 'Pages';
  }

  function sectionIconFromUrl(url) {
    if (url.indexOf('/homeworks/') > -1) return '\uD83D\uDCDD';
    if (url.indexOf('/textbook/') > -1) return '\uD83D\uDCD6';
    if (url.indexOf('/tools/') > -1) return '\uD83E\uDDF0';
    return '\uD83D\uDCC4';
  }

  function openSearch(prefill) {
    var els = getEls();
    if (!els.overlay) return;
    els.overlay.setAttribute('aria-hidden', 'false');
    els.overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    activeIndex = -1; resultUrls = [];
    resetView(els);
    if (prefill && els.input) { els.input.value = prefill; doSearch(prefill); }
    setTimeout(function() { if (els.input) els.input.focus(); }, 50);
    loadPagefind();
  }

  function closeSearch() {
    var els = getEls();
    if (!els.overlay) return;
    els.overlay.setAttribute('aria-hidden', 'true');
    els.overlay.classList.remove('open');
    document.body.style.overflow = '';
    if (els.input) els.input.value = '';
    resetView(els);
    activeIndex = -1; resultUrls = [];
    updateClearBtn();
  }

  function resetView(els) {
    // Show quick links, hide everything else
    if (els.quick) els.quick.style.display = '';
    if (els.skeleton) els.skeleton.style.display = 'none';
    if (els.noResults) els.noResults.style.display = 'none';
    if (els.count) els.count.textContent = '';
    // Remove any result elements
    if (els.results) els.results.querySelectorAll('.search-result, .search-group, .search-result__more').forEach(function(el) { el.remove(); });
    if (els.icon) els.icon.classList.remove('search-icon--searching');
  }

  function updateClearBtn() {
    var els = getEls();
    if (els.clear) els.clear.style.display = (els.input && els.input.value.length > 0) ? 'flex' : 'none';
  }

  function setActiveResult(idx) {
    var items = document.querySelectorAll('.search-result');
    items.forEach(function(el, i) { el.classList.toggle('search-result--active', i === idx); });
    activeIndex = idx;
    if (items[idx]) items[idx].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  async function doSearch(query) {
    var els = getEls();
    activeIndex = -1; resultUrls = [];

    if (!query || query.trim().length < 2) { resetView(els); return; }

    // Show skeleton, hide quick links
    if (els.quick) els.quick.style.display = 'none';
    if (els.noResults) els.noResults.style.display = 'none';
    if (els.skeleton) els.skeleton.style.display = '';
    if (els.icon) els.icon.classList.add('search-icon--searching');
    els.results.querySelectorAll('.search-result, .search-group, .search-result__more').forEach(function(el) { el.remove(); });

    var pf = await loadPagefind();
    if (els.icon) els.icon.classList.remove('search-icon--searching');
    if (!pf) {
      if (els.skeleton) els.skeleton.style.display = 'none';
      if (els.noResults) els.noResults.style.display = '';
      if (els.noResultsText) els.noResultsText.textContent = 'Search available after building the site';
      return;
    }

    var search = await pf.search(query);
    if (els.skeleton) els.skeleton.style.display = 'none';

    if (!search.results.length) {
      if (els.noResults) els.noResults.style.display = '';
      if (els.noResultsText) els.noResultsText.textContent = 'No results for \u201c' + query + '\u201d';
      if (els.count) els.count.textContent = '0';
      return;
    }

    if (els.count) els.count.textContent = search.results.length + (search.results.length === 1 ? ' result' : ' results');

    // Load result data
    var max = Math.min(search.results.length, 8);
    var items = [];
    for (var i = 0; i < max; i++) {
      var data = await search.results[i].data();
      items.push({ title: (data.meta && data.meta.title) || 'Untitled', excerpt: data.excerpt || '', url: data.url || '#' });
    }

    // Group by section
    var groups = {};
    var groupOrder = [];
    for (var j = 0; j < items.length; j++) {
      var sec = sectionFromUrl(items[j].url);
      if (!groups[sec]) { groups[sec] = []; groupOrder.push(sec); }
      groups[sec].push(items[j]);
    }

    var html = '';
    var globalIdx = 0;
    for (var g = 0; g < groupOrder.length; g++) {
      var groupName = groupOrder[g];
      var groupItems = groups[groupName];
      html += '<div class="search-group"><span class="search-group__label">' + groupName + '</span></div>';
      for (var k = 0; k < groupItems.length; k++) {
        var item = groupItems[k];
        var crumb = breadcrumbFromUrl(item.url);
        var ico = sectionIconFromUrl(item.url);
        resultUrls.push(item.url);

        var clean = item.excerpt.replace(/<(?!\/?(mark)\b)[^>]+>/gi, '').replace(/\s+/g, ' ').trim();
        var mp = clean.indexOf('<mark>');
        if (mp > 80) clean = '...' + clean.substring(mp - 40);
        if (clean.length > 150) { var c = clean.lastIndexOf(' ', 150); clean = clean.substring(0, c > 60 ? c : 150) + '...'; }

        html += '<a class="search-result" href="' + item.url + '" data-idx="' + globalIdx + '" style="animation-delay:' + (globalIdx * 30) + 'ms">';
        html += '<span class="search-result__icon">' + ico + '</span>';
        html += '<div class="search-result__body">';
        html += '<span class="search-result__title">' + escapeHtml(item.title) + '</span>';
        if (crumb) html += '<span class="search-result__crumb">' + escapeHtml(crumb) + '</span>';
        if (clean) html += '<span class="search-result__excerpt">' + clean + '</span>';
        html += '</div>';
        html += '</a>';
        globalIdx++;
      }
    }

    if (search.results.length > max) {
      html += '<div class="search-result__more">' + (search.results.length - max) + ' more results</div>';
    }

    if (els.results) els.results.insertAdjacentHTML('beforeend', html);
  }

  function escapeHtml(s) { var d = document.createElement('div'); d.appendChild(document.createTextNode(s)); return d.innerHTML; }

  function initSearch() {
    var els = getEls();
    if (els.backdrop) els.backdrop.addEventListener('click', closeSearch);
    if (els.clear) {
      els.clear.style.display = 'none';
      els.clear.addEventListener('click', function() {
        if (els.input) { els.input.value = ''; els.input.focus(); }
        resetView(els); activeIndex = -1; resultUrls = []; updateClearBtn();
      });
    }
    if (els.input) {
      els.input.addEventListener('input', function() {
        updateClearBtn();
        clearTimeout(debounceTimer);
        var q = els.input.value;
        debounceTimer = setTimeout(function() { doSearch(q); }, 200);
      });
    }
    if (els.overlay) {
      els.overlay.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { e.preventDefault(); closeSearch(); return; }
        var items = document.querySelectorAll('.search-result');
        if (!items.length) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = activeIndex < items.length - 1 ? activeIndex + 1 : 0; setActiveResult(activeIndex); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = activeIndex > 0 ? activeIndex - 1 : items.length - 1; setActiveResult(activeIndex); }
        else if (e.key === 'Enter' && activeIndex >= 0 && resultUrls[activeIndex]) { e.preventDefault(); window.location.href = resultUrls[activeIndex]; }
      });
    }
    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); var o = getEls().overlay; if (o && o.classList.contains('open')) closeSearch(); else openSearch(); }
    });
  }

  document.addEventListener('click', function(e) {
    var t = e.target;
    while (t && t !== document) {
      if (t.id === 'nav-search' || (t.classList && t.classList.contains('nav-search'))) { e.preventDefault(); openSearch(); return; }
      if (t.id === 'sidebar-search-input' || (t.classList && t.classList.contains('docs-sidebar__search'))) { e.preventDefault(); openSearch(); return; }
      t = t.parentNode;
    }
  });

  window.__ictSearch = { open: openSearch, close: closeSearch };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSearch);
  else initSearch();
  document.addEventListener('astro:after-swap', initSearch);
})();
</script>

<style>
  .search-overlay { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-start; justify-content: center; padding-top: 10vh; visibility: hidden; opacity: 0; transition: opacity 0.15s ease, visibility 0.15s ease; }
  .search-overlay.open { visibility: visible; opacity: 1; }
  .search-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .search-dialog { position: relative; width: 100%; max-width: 36rem; max-height: 75vh; margin: 0 1rem; background: #fff; border-radius: 14px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3), 0 0 0 1px rgba(0,0,0,0.04); display: flex; flex-direction: column; overflow: hidden; transform: translateY(-10px) scale(0.98); transition: transform 0.2s cubic-bezier(0.22,1,0.36,1); }
  .search-overlay.open .search-dialog { transform: translateY(0) scale(1); }

  /* Input */
  .search-input-wrap { display: flex; align-items: center; gap: 0.625rem; padding: 0.875rem 1.25rem; border-bottom: 1px solid #E5E7EB; }
  .search-input-icon { width: 1.25rem; height: 1.25rem; color: var(--color-accent); flex-shrink: 0; transition: opacity 0.2s ease; }
  .search-icon--searching { animation: search-pulse 0.8s ease infinite; }
  @keyframes search-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .search-input { flex: 1; border: none; outline: none; background: none; font-family: var(--font-body); font-size: 1rem; color: #1A1A2E; min-width: 0; }
  .search-input::placeholder { color: #9CA3AF; }
  .search-count { font-family: var(--font-mono); font-size: 0.625rem; color: #9CA3AF; flex-shrink: 0; }
  .search-clear { display: none; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; border: none; background: #F3F4F6; border-radius: 50%; cursor: pointer; color: #6B7280; flex-shrink: 0; padding: 0; transition: background 0.1s ease; }
  .search-clear:hover { background: #E5E7EB; color: #1A1A2E; }
  .search-clear svg { width: 0.75rem; height: 0.75rem; }
  .search-esc { font-family: var(--font-mono); font-size: 0.5625rem; font-weight: 500; color: #9CA3AF; background: #F3F4F6; border: 1px solid #E5E7EB; border-radius: 4px; padding: 0.125rem 0.375rem; flex-shrink: 0; }

  /* Results area */
  .search-results { overflow-y: auto; flex: 1; padding: 0.375rem; }

  /* Quick links */
  .search-quick__label { font-family: var(--font-body); font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; padding: 0.5rem 0.75rem 0.375rem; }
  .search-quick__link { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.75rem; border-radius: 8px; text-decoration: none; color: inherit; transition: background 0.1s ease; }
  .search-quick__link:hover { background: #F3F4F6; }
  .search-quick__icon { font-size: 1rem; flex-shrink: 0; }
  .search-quick__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .search-quick__name { font-size: 0.8125rem; font-weight: 600; color: #1A1A2E; }
  .search-quick__desc { font-size: 0.6875rem; color: #9CA3AF; }
  .search-quick__arrow { width: 1rem; height: 1rem; color: #D1D5DB; flex-shrink: 0; transition: transform 0.15s ease, color 0.15s ease; }
  .search-quick__link:hover .search-quick__arrow { transform: translateX(2px); color: var(--color-accent); }

  /* Skeleton */
  .search-skeleton { padding: 0.5rem; }
  .search-skeleton__item { padding: 0.625rem 0.75rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .search-skeleton__bar { height: 0.625rem; border-radius: 4px; background: #E5E7EB; animation: skel-pulse 1.2s ease infinite; }
  .search-skeleton__bar--short { width: 40%; }
  @keyframes skel-pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

  /* No results */
  .search-no-results { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 2rem 1rem; text-align: center; }
  .search-no-results__icon { width: 2.5rem; height: 2.5rem; color: #D1D5DB; }
  .search-no-results__text { font-size: 0.875rem; font-weight: 600; color: #6B7280; }
  .search-no-results__hint { font-size: 0.75rem; color: #9CA3AF; }
  .search-no-results__action { font-size: 0.75rem; font-weight: 600; color: var(--color-accent); text-decoration: none; margin-top: 0.25rem; transition: opacity 0.15s ease; }
  .search-no-results__action:hover { opacity: 0.8; }

  /* Group headers */
  .search-group { padding: 0.5rem 0.75rem 0.125rem; }
  .search-group__label { font-family: var(--font-body); font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; }

  /* Result items */
  @keyframes result-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .search-result { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 8px; text-decoration: none; color: inherit; border-left: 2px solid transparent; transition: background 0.1s ease, border-color 0.1s ease; animation: result-in 0.25s ease both; }
  .search-result:hover { background: #F3F4F6; }
  .search-result--active { background: rgba(232,119,34,0.06); border-left-color: var(--color-accent); }
  .search-result__icon { font-size: 0.75rem; line-height: 1.5; flex-shrink: 0; margin-top: 0.05rem; }
  .search-result__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.05rem; }
  .search-result__title { font-family: var(--font-heading); font-size: 0.8125rem; font-weight: 600; color: #1A1A2E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.3; }
  .search-result--active .search-result__title { color: var(--color-accent); }
  .search-result__crumb { font-family: var(--font-mono); font-size: 0.575rem; color: #B0B8C4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search-result__excerpt { font-size: 0.72rem; color: #6B7280; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
  .search-result__excerpt :global(mark) { background: rgba(232,119,34,0.15); color: #B45309; border-radius: 2px; padding: 0 2px; }
  .search-result__more { text-align: center; font-size: 0.72rem; color: #9CA3AF; padding: 0.5rem; }

  /* Footer */
  .search-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1.25rem; border-top: 1px solid #E5E7EB; background: #FAFBFC; }
  .search-footer__hints { display: flex; gap: 0.875rem; }
  .search-hint { display: flex; align-items: center; gap: 0.25rem; font-size: 0.625rem; color: #9CA3AF; }
  .search-hint kbd { font-family: var(--font-mono); font-size: 0.5625rem; background: #F3F4F6; border: 1px solid #E5E7EB; border-radius: 3px; padding: 0 0.25rem; min-width: 1rem; text-align: center; line-height: 1.5; color: #6B7280; }
  .search-footer__powered { font-family: var(--font-mono); font-size: 0.5625rem; color: #C0C7D0; }
  @media (max-width: 480px) { .search-footer__hints { gap: 0.5rem; } .search-footer__powered { display: none; } }

  /* Dark mode */
  :global([data-theme="dark"]) .search-dialog { background: #162033; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04); }
  :global([data-theme="dark"]) .search-input-wrap { border-bottom-color: #2D3F59; }
  :global([data-theme="dark"]) .search-input { color: #F1F5F9; }
  :global([data-theme="dark"]) .search-input::placeholder { color: #64748B; }
  :global([data-theme="dark"]) .search-esc { background: #1B2D4A; border-color: #2D3F59; color: #64748B; }
  :global([data-theme="dark"]) .search-clear { background: #1B2D4A; color: #94A3B8; }
  :global([data-theme="dark"]) .search-clear:hover { background: #2D3F59; color: #F1F5F9; }
  :global([data-theme="dark"]) .search-quick__link:hover { background: #1B2D4A; }
  :global([data-theme="dark"]) .search-quick__name { color: #F1F5F9; }
