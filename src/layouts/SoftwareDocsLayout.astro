---
import DocsLayout from './DocsLayout.astro';
import { documentationModules } from '../data/documentation';
interface Props {
  title: string;
  description: string;
  activeModule: string;
  toc?: { id: string; label: string }[];
}
const base = import.meta.env.BASE_URL;
---
<DocsLayout {...Astro.props} variant="software" sidebarLabel="Software" sidebarModules={documentationModules(base)}>
 <div class="software-docs" data-library={Astro.props.activeModule === 'index' ? '' : undefined}>
  {Astro.props.activeModule !== 'index' && <nav class="doc-breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}documentation/`}>Documentation</a>
    {Astro.props.activeModule !== 'index' && <><span aria-hidden="true"> / </span><span>{Astro.props.title.replace(' · CEE 406', '')}</span></>}
  </nav>}
  {Astro.props.activeModule !== 'index' && <nav class="software-mobile" aria-label="Software guides">
    {documentationModules(base).map(item => <a href={item.href} aria-current={item.id === Astro.props.activeModule ? 'page' : undefined}>
      {item.icon.startsWith('image:') && <span class="software-mobile__brand" aria-hidden="true"><img src={item.icon.slice(6)} width="24" height="24" alt="" /></span>}
      <span>{item.label}</span>
    </a>)}
  </nav>}
  {!!Astro.props.toc?.length && <details class="software-sections"><summary>On this page <span>{Astro.props.toc.length} sections</span></summary><nav aria-label="Page sections">{Astro.props.toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></details>}
  <slot />
  {Astro.props.activeModule !== 'index' && <footer class="software-footer"><a href={`${base}documentation/`}>← All software</a><button type="button" data-print-guide hidden>Print guide</button></footer>}
 </div>
</DocsLayout>
<script>
  function initSoftwareTools() {
    document.querySelectorAll<HTMLElement>('.software-mobile').forEach(nav => {
      const current = nav.querySelector<HTMLElement>('[aria-current="page"]');
      if (current && current.offsetLeft > nav.clientWidth / 2) nav.scrollLeft = current.offsetLeft - nav.offsetLeft - 24;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-print-guide]').forEach(button => {
      if (button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
  }
  initSoftwareTools();
  document.addEventListener('astro:page-load', initSoftwareTools);
  const printDetails = new Map<HTMLDetailsElement, boolean>();
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLDetailsElement>('.software-docs details').forEach(details => {
      printDetails.set(details, details.open);
      details.open = true;
    });
  });
  window.addEventListener('afterprint', () => {
    printDetails.forEach((open, details) => { details.open = open; });
    printDetails.clear();
  });
</script>
<style>
  .software-docs { min-width: 0; }
  .software-sections { border-block: 1px solid var(--color-border); margin-bottom: 1.5rem; }
  .software-sections summary { padding: .7rem 1rem; cursor: pointer; font-size: .85rem; font-weight: 600; }
  .software-sections summary span { float: right; color: var(--color-text-muted); font-weight: 400; font-size: .75rem; }
  .software-sections nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 .75rem; padding: 0 1rem .75rem; }
  .software-sections a { display: flex; align-items: center; min-height: 44px; font-size: .8rem; color: var(--color-text-muted); }
  .software-sections a:hover { color: var(--color-accent); }
  .software-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); margin-top: 2rem; padding-top: 1rem; font-size: .8125rem; }
  .software-footer a { color: var(--color-accent); }
  .software-footer button { border: 0; background: transparent; color: var(--color-text-muted); font: inherit; padding: .4rem .75rem; min-height: 44px; cursor: pointer; }
  .software-footer button:hover { color: var(--color-text); }
  .software-footer button[hidden] { display: none; }
  :global(.software-docs .doc-header) { padding: .5rem 0 1.75rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); }
  :global(.software-docs .doc-header__badge) { background: transparent; padding: 0; border-radius: 0; font-size: .75rem; font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--color-text-muted); margin-bottom: .6rem; }
  :global(.docs-shell:has(.software-docs[data-library])) { grid-template-columns: 1fr; }
  :global(.docs-content:has(.software-docs[data-library])) { max-width: none; }
  @media (min-width: 768px) { :global(.docs-shell:has(.software-docs[data-library])) { grid-template-columns: 13rem minmax(0, 1fr); } }
  @media (min-width: 1200px) { .software-sections { display: none; } }
  :global(.software-docs ol.doc-list) { list-style-type: decimal; }
  :global(.software-docs ul.doc-list) { list-style-type: disc; }
  :global(.software-docs .doc-list > li) { margin-bottom: .65rem; }
  :global(.software-docs .doc-list :is(ul, ol)) { margin: .35rem 0 .6rem; padding-left: 1.1rem; font-size: .9rem; line-height: 1.65; color: var(--color-text-muted); }
  :global(.software-docs .doc-list ul) { list-style-type: disc; }
  :global(.software-docs ul.doc-list > li > ul) { list-style-type: circle; }
  :global(.software-docs .doc-list ul ul) { list-style-type: circle; }
  :global(.software-docs .doc-list ol ol) { list-style-type: lower-alpha; }
  :global(.software-docs .doc-list :is(ul, ol) > li) { margin-bottom: .3rem; }
  :global(.software-docs .doc-list > li::marker) { color: var(--color-accent); font-weight: 500; }
  @media (max-width: 480px) { :global(.software-docs .doc-list :is(ul, ol)) { padding-left: 1rem; } }
  @media print {
    :global(#main-nav), :global(body > footer), :global(.docs-sidebar), :global(.docs-toc), .software-mobile, .software-footer, .software-sections { display: none !important; }
    .software-docs { --color-text: #1a1a2e; --color-text-muted: #545b67; --color-surface: #fff; --color-surface-alt: #f5f5f5; --color-border: #ccc; }
    :global(.software-docs h1), :global(.software-docs h2), :global(.software-docs h3) { color: #1a1a2e !important; }
    :global(.docs-shell:has(.software-docs)) { display: block; padding: 0; }
    :global(.docs-content:has(.software-docs)) { max-width: none; }
    :global(.software-docs h2), :global(.software-docs h3) { break-after: avoid; }
    :global(.software-docs figure), :global(.software-docs .doc-callout) { break-inside: avoid; }
  }
  .software-mobile { display: flex; gap: 1rem; overflow-x: auto; scrollbar-width: thin; scroll-snap-type: x proximity; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; font-size: .8125rem; }
  .software-mobile a { display: flex; align-items: center; flex-shrink: 0; min-height: 44px; padding: .35rem .125rem .6rem; color: var(--color-text-muted); border-bottom: 2px solid transparent; scroll-snap-align: start; transition: color .18s ease; }
  .software-mobile a:hover { color: var(--color-text); }
  .software-mobile__brand { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 30px; height: 30px; margin-right: .5rem; border: 1px solid #e4e8ef; border-radius: 6px; background: #fff; }
  .software-mobile__brand img { display: block; width: 24px; height: 24px; object-fit: contain; }
  .software-mobile a[aria-current] { color: var(--color-text); font-weight: 600; border-bottom-color: var(--color-accent); }
  @media (prefers-reduced-motion: reduce) { .software-mobile a { transition: none; } }
  @media (min-width: 768px) { .software-mobile { display: none; } }
</style>
