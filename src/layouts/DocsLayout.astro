---
import BaseLayout from './BaseLayout.astro';

interface SidebarModule {
  id: string;
  label: string;
  icon: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  sidebarLabel?: string;
  sidebarModules?: SidebarModule[];
  activeModule: string;
  toc?: { id: string; label: string }[];
  variant?: 'software';
}

const base = import.meta.env.BASE_URL;

const defaultModules: SidebarModule[] = [
  { id: 'home', label: 'Home', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4', href: `${base}docs/getting-started/` },
  { id: 'hardware', label: 'Hardware', icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z', href: `${base}docs/getting-started/hardware/` },
  { id: 'abaqus', label: 'SIMULIA Abaqus', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5', href: `${base}docs/getting-started/abaqus/` },
  { id: 'ides', label: 'IDEs', icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6M14 4l-4 16', href: `${base}docs/getting-started/ides/` },
  { id: 'python', label: 'Python', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm4 0h-2v-6h2v6zm-3-8a1.5 1.5 0 110-3 1.5 1.5 0 010 3z', href: `${base}docs/getting-started/python/` },
  { id: 'github', label: 'GitHub', icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22', href: `${base}docs/getting-started/github/` },
  { id: 'cli', label: 'Command Line (CLI)', icon: 'M4 17l6-6-6-6M12 19h8', href: `${base}docs/getting-started/cli/` },
];

const { title, description, activeModule, toc = [], sidebarLabel = 'Getting Started', sidebarModules = defaultModules } = Astro.props;
const modules = sidebarModules;
---

<BaseLayout title={title} description={description} indexMain={false}>
  <div class="docs-shell" data-docs-variant={Astro.props.variant}>
    <!-- Left sidebar: submodule nav -->
    <aside class="docs-sidebar" id="docs-sidebar">
      <button class="docs-sidebar__search" id="sidebar-search-input" type="button" aria-label="Search documentation">
        <svg class="docs-sidebar__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="docs-sidebar__search-input">Search docs</span>
        <kbd class="docs-sidebar__search-kbd">⌘K</kbd>
      </button>
      <div class="docs-sidebar__section">
        <div class="docs-sidebar__label">{sidebarLabel}</div>
        <nav class="docs-sidebar__nav" aria-label={`${sidebarLabel} modules`}>
          {modules.map(mod => (
            <a
              href={mod.href}
              class:list={['docs-sidebar__link', { active: activeModule === mod.id }]}
              aria-current={activeModule === mod.id ? 'page' : undefined}
              data-module={mod.id}
            >
              {mod.icon.startsWith('text:') ? (
                <span class="docs-sidebar__badge" aria-hidden="true">{mod.icon.slice(5)}</span>
              ) : (
                <svg class="docs-sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={mod.icon} /></svg>
              )}
              <span>{mod.label}</span>
              {Astro.props.variant === 'software' && <svg class="docs-sidebar__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 4 4 4-4 4" /></svg>}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Center: main content -->
    <main class="docs-content" data-pagefind-body>
      <slot />
    </main>

    <!-- Right: page TOC -->
    {toc.length > 0 && (
      <aside class="docs-toc" id="docs-toc">
        <div class="docs-toc__header">
          <span>On this page</span>
          <div class="docs-toc__progress">
            <div class="docs-toc__progress-fill" id="toc-progress"></div>
          </div>
        </div>
        <nav class="docs-toc__nav" aria-label="Table of contents">
          {toc.map(item => (
            <a href={`#${item.id}`} class="docs-toc__link" data-toc-link={item.id}>
              <span class="docs-toc__marker"></span>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  let cleanupDocsToc = () => {};
  function initDocsToc() {
    cleanupDocsToc();
    const links = document.querySelectorAll('[data-toc-link]');
    const sections = document.querySelectorAll('[data-section]');
    const progressBar = document.getElementById('toc-progress');
    if (!links.length) return;
    const controller = new AbortController();
    let observer: IntersectionObserver | undefined;
    cleanupDocsToc = () => { controller.abort(); observer?.disconnect(); };

    if (sections.length) {
      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('data-section') || entry.target.id;
            links.forEach(l => {
              const active = l.getAttribute('data-toc-link') === id;
              l.classList.toggle('active', active);
              if (active) l.setAttribute('aria-current', 'location');
              else l.removeAttribute('aria-current');
            });
          }
        }
      }, { rootMargin: '-15% 0px -65% 0px', threshold: 0 });
      sections.forEach(s => observer!.observe(s));
    }

    // Progress
    function updateProgress() {
      const content = document.querySelector('.docs-content');
      if (!content || !progressBar) return;
      const rect = content.getBoundingClientRect();
      const total = content.scrollHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = total > 0 ? Math.max(0, Math.min(100, (scrolled / total) * 100)) : 100;
      progressBar.style.width = pct + '%';
    }
    window.addEventListener('scroll', updateProgress, { passive: true, signal: controller.signal });
    updateProgress();

    // Smooth scroll
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        if (e instanceof MouseEvent && (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey)) return;
        const id = link.getAttribute('data-toc-link');
        const target = document.getElementById(id || '');
        if (!target) return;
        e.preventDefault();
        history.pushState(null, '', `#${id}`);
        target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }, { signal: controller.signal });
    });
  }

  initDocsToc();
  document.addEventListener('astro:after-swap', initDocsToc);
</script>

<style>
  /* ── Shell: 3-column layout ── */
  .docs-shell {
    display: grid;
    grid-template-columns: 1fr;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .docs-shell {
      grid-template-columns: 13rem 1fr;
      padding: 2rem 2rem 5rem;
    }
  }

  @media (min-width: 1200px) {
    .docs-shell {
      grid-template-columns: 13rem 1fr 13rem;
    }
  }

  /* ── Left sidebar ── */
  .docs-sidebar {
    display: none;
  }

  @media (min-width: 768px) {
    .docs-sidebar {
      display: block;
      position: sticky;
      top: 4rem;
      max-height: calc(100vh - 4.5rem);
      overflow-y: auto;
      padding-right: 1rem;
    }
  }

  /* ── Sidebar search ── */
  .docs-sidebar__search {
    width: 100%;
    text-align: left;
    font: inherit;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    margin-bottom: 1rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 7px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .docs-sidebar__search:hover {
    border-color: var(--color-accent);
    background: rgba(232, 119, 34, 0.04);
  }
  .docs-sidebar__search > * { pointer-events: none; }

  .docs-sidebar__search-icon {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .docs-sidebar__search-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--color-text-muted);
    cursor: pointer;
    min-width: 0;
  }

  .docs-sidebar__search-kbd {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.0625rem 0.3rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .docs-sidebar__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
    margin-bottom: 0.5rem;
  }

  .docs-sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .docs-sidebar__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
    line-height: 1.35;
  }

  .docs-sidebar__link:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
  }

  .docs-sidebar__link.active {
    color: var(--color-accent);
    background: rgba(232, 119, 34, 0.06);
    font-weight: 600;
  }

  .docs-sidebar__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    opacity: 0.5;
  }

  .docs-sidebar__badge {
    font-family: var(--font-mono);
    font-size: 0.575rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    flex-shrink: 0;
    min-width: 1.9rem;
    text-align: center;
  }

  .docs-sidebar__link.active .docs-sidebar__badge {
    background: rgba(232, 119, 34, 0.1);
    border-color: rgba(232, 119, 34, 0.35);
    color: var(--color-accent);
  }

  .docs-sidebar__link.active .docs-sidebar__icon {
    opacity: 1;
    color: var(--color-accent);
  }

  /* ── Right TOC ── */
  .docs-toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .docs-toc {
      display: block;
      position: sticky;
      top: 4rem;
      max-height: calc(100vh - 4.5rem);
      overflow-y: auto;
      padding-left: 1rem;
      border-left: 1px solid var(--color-border);
    }
  }

  .docs-toc__header {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .docs-toc__progress {
    height: 2px;
    background: var(--color-border);
    border-radius: 1px;
    overflow: hidden;
  }

  .docs-toc__progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light));
    border-radius: 1px;
    transition: width 0.1s ease-out;
  }

  .docs-toc__nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .docs-toc__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
    line-height: 1.4;
  }

  .docs-toc__marker {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-border);
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .docs-toc__link:hover {
    color: var(--color-text);
  }

  .docs-toc__link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .docs-toc__link.active .docs-toc__marker {
    background: var(--color-accent);
    transform: scale(1.5);
    box-shadow: 0 0 6px rgba(232, 119, 34, 0.4);
  }

  /* ── Content area ── */
  .docs-content {
    min-width: 0;
    max-width: 52rem;
  }

  /* ── Dark mode ── */
  :global([data-theme="dark"]) .docs-toc__progress {
    background: #1f2937;
  }

  :global([data-theme="dark"]) .docs-sidebar__link.active {
    background: rgba(232, 119, 34, 0.08);
  }
  /* Software navigation keeps one clear current-page marker. */
  [data-docs-variant="software"] .docs-sidebar { align-self: start; padding-right: 1.25rem; border-right: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent); }
  [data-docs-variant="software"] .docs-sidebar__search { min-height: 42px; border-color: color-mix(in srgb, var(--color-border) 75%, transparent); border-radius: 8px; background: transparent; margin-bottom: 1.75rem; }
  [data-docs-variant="software"] .docs-sidebar__search:hover { border-color: var(--color-accent); background: var(--color-surface-alt); }
  [data-docs-variant="software"] .docs-sidebar__label { text-transform: none; letter-spacing: 0; font-weight: 500; font-size: .75rem; padding: 0 .75rem; margin-bottom: .75rem; }
  [data-docs-variant="software"] .docs-sidebar__nav { gap: .375rem; }
  [data-docs-variant="software"] .docs-sidebar__link { position: relative; min-height: 46px; padding: .65rem .65rem .65rem .75rem; gap: .65rem; border-radius: 8px; font-size: .8125rem; transition: color .18s ease, background .18s ease; }
  [data-docs-variant="software"] .docs-sidebar__link:first-child { margin-bottom: .6rem; }
  [data-docs-variant="software"] .docs-sidebar__link::before { content: ''; position: absolute; inset: .85rem auto .85rem 0; width: 2px; border-radius: 2px; background: var(--color-accent); opacity: 0; transform: scaleY(.4); transition: opacity .2s ease, transform .2s ease; }
  [data-docs-variant="software"] .docs-sidebar__link.active::before { opacity: 1; transform: scaleY(1); }
  [data-docs-variant="software"] .docs-sidebar__link.active { background: color-mix(in srgb, var(--color-accent) 7%, transparent); color: var(--color-text); font-weight: 600; }
  [data-docs-variant="software"] .docs-sidebar__badge { display: flex; align-items: center; justify-content: center; width: 1.7rem; height: 1.7rem; min-width: 1.7rem; padding: 0; font-size: .65rem; font-weight: 500; border: 0; border-radius: 6px; color: var(--nav-color, var(--color-text-muted)); background: color-mix(in srgb, var(--nav-color, var(--color-text-muted)) 8%, transparent); }
  [data-docs-variant="software"] [data-module="faarfield"] { --nav-color: var(--phase-design); }
  [data-docs-variant="software"] [data-module="winjulea"] { --nav-color: var(--phase-analysis); }
  [data-docs-variant="software"] [data-module="drip"] { --nav-color: var(--phase-materials); }
  [data-docs-variant="software"] [data-module="pavement-me"] { --nav-color: var(--phase-loads); }
  .docs-sidebar__arrow { width: .8rem; height: .8rem; flex-shrink: 0; margin-left: auto; color: var(--color-text-muted); opacity: 0; transform: translateX(-3px); transition: opacity .18s ease, transform .18s ease; }
  .docs-sidebar__link:hover .docs-sidebar__arrow, .docs-sidebar__link:focus-visible .docs-sidebar__arrow, .docs-sidebar__link.active .docs-sidebar__arrow { opacity: 1; transform: none; }
  [data-docs-variant="software"] .docs-toc { align-self: start; }
  @media (prefers-reduced-motion: reduce) {
    [data-docs-variant="software"] .docs-sidebar__link, [data-docs-variant="software"] .docs-sidebar__link::before, .docs-sidebar__arrow { transition: none; }
  }
</style>
